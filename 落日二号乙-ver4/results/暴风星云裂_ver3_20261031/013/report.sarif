            "has_poc": true,
            "origin": "llm_finding"
          }
        },
        {
          "ruleId": "sunset/weak_hash",
          "level": "note",
          "message": {
            "text": "用户密码使用无盐 MD5 哈希存储\n\n013.php 第 27 行对用户新密码直接调用 md5($pass_new) 后写入数据库，未加盐、未使用 password_hash 等慢哈希算法。数据库泄露时攻击者可通过彩虹表快速还原明文密码。"
          },
