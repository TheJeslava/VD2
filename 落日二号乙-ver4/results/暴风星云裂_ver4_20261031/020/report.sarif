            "origin": "rule"
          }
        },
        {
          "ruleId": "sunset/client_side_validation",
          "level": "error",
          "message": {
            "text": "020.php 第 15 行外部脚本引入缺少服务端校验（CWE-602 客户端校验依赖）\n\n020.php:14-15 将 `$_POST['include']` 拼入 `<script src='...'>`，由浏览器加载外部 JavaScript。候选标注为“客户端校验绕过”，但给定片段中并未出现任何客户端校验逻辑（无 JS 校验函数、无 onsubmit 校验），也未出现服务端对 include 值的合法性校验。实际问题是：脚本来源完全由用户输入决定，服务端未做任何白名单或协议校验，安全边界被交给浏览器/CSP 承担。"
          },
          "locations": [
