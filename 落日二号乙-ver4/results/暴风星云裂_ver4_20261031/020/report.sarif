            "origin": "rule"
          }
        },
        {
          "ruleId": "sunset/xss",
          "level": "warning",
          "message": {
            "text": "020.php 中 POST 参数 include 未编码直接拼入 <script src> 导致反射型 XSS\n\n020.php 第 13-17 行读取 $_POST['include']，未做任何 HTML 属性编码或白名单校验，直接拼接进 <script src='...'> 的 src 属性并输出到响应体。攻击者可提交包含单引号闭合属性的 payload（如 `' onerror='alert(1)` 或 `'></script><script>alert(1)</script>`），突破 script 标签属性上下文，注入任意 HTML/JS。虽然页面设置了 CSP（第 3-5 行），但 CSP 的 script-src 白名单包含 unpkg.com、cdn.jsdelivr.net、pastebin.com 等可托管任意 JS 的公共 CDN，攻击者可借助这些域加载自己的脚本，CSP 无法阻止。"
          },
          "locations": [
