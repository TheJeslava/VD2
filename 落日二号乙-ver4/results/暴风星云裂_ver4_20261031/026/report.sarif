      "results": [
        {
          "ruleId": "sunset/command_injection",
          "level": "error",
          "message": {
            "text": "026.php ping 功能通过 $_REQUEST['ip'] 拼接 shell_exec 导致命令注入（RCE）\n\n026.php 在收到 POST 参数 Submit 后，直接从 $_REQUEST['ip'] 读取用户输入并赋值给 $target，未做任何白名单、转义（escapeshellarg/escapeshellcmd）或格式校验，随后在第 10 行（Windows 分支）与第 14 行（*nix 分支）将 $target 直接字符串拼接到 shell_exec('ping ...' . $target) 中执行。攻击者可通过在 ip 参数中注入 shell 元字符（如 ; | & $() 反引号）在服务器上执行任意系统命令，获得远程代码执行。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "026.php"
                },
                "region": {
                  "startLine": 5,
                  "endLine": 14
                }
              }
            }
          ],
          "partialFingerprints": {
            "sunsetFindingId": "LLM-709cbd914c63"
          },
          "properties": {
            "finding_id": "LLM-709cbd914c63",
            "confidence": 0.9,
            "verdict": "candidate",
            "evidence_level": "llm_inferred",
            "cwe": "CWE-78",
            "endpoint": "/026.php",
            "http_method": "POST",
            "has_poc": true,
            "origin": "llm_finding"
          }
        },
        {
          "ruleId": "sunset/command_injection",
          "level": "error",
          "message": {
            "text": "026.php Windows 分支 ping 命令拼接导致 OS 命令注入（CWE-78）\n\n攻击者通过 HTTP 查询参数 `ip` 提供输入，该参数在 026.php:5 被读入变量 `target`。026.php:8 使用 `stristr(php_uname('s'), 'Windows NT')` 判断运行平台，命中 Windows 分支后，026.php:10 执行 `$cmd = shell_exec( 'ping  ' . $target );`，将 `target` 未经任何转义、白名单校验或参数化直接拼接到 shell 命令字符串中。由于 `shell_exec` 会把整串交给系统 shell 解析，`target` 中的 `&`、`|`、`&&`、`;`（Windows cmd 下为 `&`、`|`、`&&`）等元字符会被解释为命令分隔符，从而在 Web 进程权限下执行任意命令。代码中不存在 escapeshellarg/escapeshellcmd、正则白名单或 IP 格式校验，因此校验完全缺失。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "026.php"
                },
                "region": {
                  "startLine": 8,
                  "endLine": 10
                }
              }
            }
          ],
          "partialFingerprints": {
            "sunsetFindingId": "GEN-a86a53dc898b"
          },
          "properties": {
            "finding_id": "GEN-a86a53dc898b",
            "confidence": 0.78,
            "verdict": "candidate",
            "evidence_level": "rule_verified+llm",
            "cwe": "CWE-78",
            "endpoint": "/026",
            "http_method": "POST",
            "has_poc": true,
            "origin": "rule"
          }
        }
