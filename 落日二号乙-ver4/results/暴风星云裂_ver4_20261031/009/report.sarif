            "origin": "rule"
          }
        },
        {
          "ruleId": "sunset/sql_injection",
          "level": "error",
          "message": {
            "text": "009.php 用户信息查询 SQL 注入（CWE-89）\n\nquery 参数 `user_id`（009.php:17）经 `$id` 在 009.php:28 拼入 `SELECT first_name, last_name, user_id, avatar FROM users WHERE user_id = '$id';`，并在 009.php:29 由 `mysqli_query` 执行。该分支在 `$user_exists` 为真时触发，未使用转义或参数化，单引号可被闭合注入。"
          },
