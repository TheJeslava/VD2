          },
          "properties": {
            "finding_id": "LLM-86c6c58e13d2",
            "confidence": 0.85,
            "verdict": "candidate",
            "evidence_level": "llm_inferred",
            "cwe": "CWE-327",
            "endpoint": "/018.php",
            "http_method": "POST",
            "has_poc": true,
            "origin": "llm_finding"
          }
        },
        {
          "ruleId": "sunset/weak_crypto",
          "level": "warning",
          "message": {
            "text": "018.php 使用 AES-128-ECB 弱加密模式（CWE-327）\n\n在 018.php 第 2-3 行的 decrypt($ciphertext, $key) 函数中，第 3 行调用 openssl_decrypt($ciphertext, 'aes-128-ecb', $key, OPENSSL_PKCS1_PADDING) 对密文进行解密，算法/模式参数被硬编码为 'aes-128-ecb'。攻击者不需要注入任何输入：只要能够获取或截获密文（例如通过接口参数、Cookie、存储文件等外部通道），就能利用 ECB 模式的确定性特征——相同明文分组产生相同密文分组——对密文进行分组重排、拼接、块替换与块删除，从而在不知道密钥的情况下篡改解密后的明文结构。此外，第 3 行把 OPENSSL_PKCS1_PADDING 作为 openssl_decrypt 的 options 参数传入，而该常量语义上属于 RSA 填充，并非 AES 分组模式填充选项，说明填充处理配置本身也不正确，进一步削弱完整性保障。校验无效的原因在于：ECB 模式不引入随机 IV、不做分组间链接，代码中也没有任何 MAC/签名或完整性校验步骤，因此解密端无法区分合法密文与被重排/拼接的密文。最终危险操作是第 3 行的解密结果 $e 被直接当作可信明文返回给上层使用（第 4 行仅判断 $e === false）。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "018.php"
                },
                "region": {
