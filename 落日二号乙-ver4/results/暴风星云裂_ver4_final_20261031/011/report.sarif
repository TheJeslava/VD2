      "results": [
        {
          "ruleId": "sunset/sql_injection",
          "level": "error",
          "message": {
            "text": "011.php 登录接口 username 参数 SQL 注入（可绕过认证）\n\n011.php 第 3 行在 $_GET['Login'] 存在时进入登录逻辑，第 5 行直接取 $_GET['username'] 赋给 $user，未做任何转义或参数化；第 12 行将 $user 直接字符串拼接进 SELECT 语句，第 13 行通过 mysqli_query 执行。攻击者可在 username 中注入 SQL 语法（如 ' OR '1'='1' -- -）改变 WHERE 条件，使查询恒真并返回 users 表首行，从而在不知道口令的情况下通过第 15 行 mysqli_num_rows == 1 的判定，进入“password protected area”。password 参数虽经 md5() 处理（第 9 行），但 md5 输出为固定 32 位十六进制，无法注入，因此注入点唯一在 username。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "011.php"
                },
                "region": {
                  "startLine": 5,
                  "endLine": 13
                }
              }
            }
          ],
          "partialFingerprints": {
            "sunsetFindingId": "LLM-c969ca7950b6"
          },
          "properties": {
            "finding_id": "LLM-c969ca7950b6",
            "confidence": 0.9,
            "verdict": "candidate",
            "evidence_level": "llm_inferred",
            "cwe": "CWE-89",
            "endpoint": "/011.php",
            "http_method": "GET",
            "has_poc": true,
            "origin": "llm_finding"
          }
        },
        {
          "ruleId": "sunset/brute_force",
          "level": "error",
          "message": {
            "text": "011.php 登录接口缺少暴力破解防护（CWE-307）\n\n011.php:3 通过 `isset($_GET['Login'])` 进入登录流程，011.php:5 读取 `username`、011.php:8 读取 `password`，随后直接查询比对。代码中未见失败计数、账户锁定、验证码、速率限制或延迟机制，攻击者可对同一接口无限次提交口令猜测。证据为 011.php:2-3 的登录入口与后续无防护的查询逻辑；运行时是否另有网关限流证据不足。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "011.php"
                },
                "region": {
                  "startLine": 2,
                  "endLine": 3
                }
              }
            }
          ],
          "partialFingerprints": {
            "sunsetFindingId": "SEM-bb3630458a80"
          },
          "properties": {
            "finding_id": "SEM-bb3630458a80",
            "confidence": 0.55,
            "verdict": "candidate",
            "evidence_level": "rule_verified+llm",
            "cwe": "CWE-307",
            "endpoint": "/011",
            "http_method": "GET",
            "has_poc": true,
            "origin": "rule"
          }
        },
        {
          "ruleId": "sunset/weak_crypto",
          "level": "warning",
          "message": {
            "text": "011.php 使用 MD5 处理口令（CWE-328 弱哈希）\n\n011.php:8 从 GET 参数 `password` 读取明文口令，011.php:9 直接调用 md5($pass) 生成摘要后用于 011.php:12 的登录比对。MD5 为快速、无盐、抗碰撞性已被攻破的哈希算法，用于口令存储/校验属安全用途误用。此处为配置/实现型弱点，不依赖 HTTP 污点链，证据为 011.php:9 的 `md5(` 调用原文。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "011.php"
                },
                "region": {
                  "startLine": 8,
                  "endLine": 9
                }
              }
            }
          ],
