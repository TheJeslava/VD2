            "finding_id": "GEN-7d549df94451",
            "confidence": 0.7,
            "verdict": "candidate",
            "evidence_level": "rule_verified+llm",
            "cwe": "CWE-434",
            "endpoint": "/044",
            "http_method": "POST",
            "has_poc": true,
            "origin": "rule"
          }
        },
        {
          "ruleId": "sunset/file_upload",
          "level": "error",
          "message": {
            "text": "DVWA 044.php 无限制文件上传导致任意 PHP 文件写入 Web 目录（RCE）\n\n044.php 在收到 POST 参数 Upload 时，直接把 $_FILES['uploaded']['name'] 经 basename() 处理后拼接到 DVWA_WEB_PAGE_TO_ROOT.\"hackable/uploads/\" 目录，并调用 move_uploaded_file() 落盘。代码未校验扩展名、MIME、文件内容，也未做白名单或重命名，攻击者可上传 .php 文件到 Web 可访问目录，随后直接请求该文件即可在服务器执行任意 PHP 代码，形成远程代码执行。basename() 仅剥离路径部分，不限制扩展名，无法阻止 webshell 上传。"
          },
          "locations": [
            {
              "physicalLocation": {
