            "confidence": 0.83,
            "verdict": "candidate",
            "evidence_level": "rule_verified+llm",
            "cwe": "CWE-89",
            "endpoint": "/022",
            "http_method": "ANY",
            "has_poc": true,
            "origin": "rule"
          }
        },
        {
          "ruleId": "sunset/path_traversal",
          "level": "error",
          "message": {
            "text": "022.php JSON 请求体读取被误判为路径穿越（证据不足）\n\n候选将 022.php:8 的 $data = json_decode(file_get_contents('php://input'), true); 标记为 path_traversal 汇点。但 file_get_contents 的参数是固定字面量 'php://input'，并非来自外部输入；外部 JSON 内容只进入 $data 变量，未参与任何文件路径构造。022.php:7 的 CONTENT_TYPE 判断也只是请求方法/类型分支，不构成路径可控。因此不存在攻击者可控路径到达文件读写操作。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "022.php"
                },
                "region": {
                  "startLine": 6,
                  "endLine": 8
                }
              }
            }
          ],
          "partialFingerprints": {
