            "confidence": 0.4,
            "verdict": "candidate",
            "evidence_level": "rule_verified+llm",
            "cwe": "CWE-22",
            "endpoint": "/022",
            "http_method": "ANY",
            "has_poc": true,
            "origin": "rule"
          }
        },
        {
          "ruleId": "sunset/weak_crypto",
          "level": "warning",
          "message": {
            "text": "022.php 使用 MD5 存储口令（CWE-328 弱哈希）\n\n022.php:39 执行 $pass_new = md5( $pass_new );，将用户新口令以无盐 MD5 形式哈希后写入数据库（022.php:43-44 的 UPDATE 语句）。MD5 属于已被证明存在碰撞且计算极快的哈希算法，用于口令存储时无法抵抗离线暴力破解与彩虹表攻击；代码中未见加盐（salt）或迭代（如 bcrypt/Argon2/PBKDF2）处理。该弱点为配置/实现型，不依赖 HTTP 污点链，根因是算法选择与缺少盐值。"
          },
          "locations": [
