          }
        },
        {
          "ruleId": "sunset/brute_force",
          "level": "error",
          "message": {
            "text": "024.php 口令修改缺少暴力破解防护（CWE-307）\n\n024.php:6-8 直接读取 $_GET['password_new'] 与 $_GET['password_conf'] 并进入修改流程，代码中未见失败计数、账户锁定、验证码或速率限制逻辑。候选将其标注为暴力破解防护缺失。但需注意：该页面为口令修改而非登录认证，且当前片段未展示任何口令校验/比对逻辑，因此“可被暴力破解”的论证依赖跨文件（登录入口）与运行时行为，现有证据不足以确认攻击者可在此端点反复猜测并获知成功与否。"
          },
