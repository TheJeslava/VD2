            "has_poc": true,
            "origin": "rule"
          }
        },
        {
          "ruleId": "sunset/csrf",
          "level": "error",
          "message": {
            "text": "DVWA 密码修改功能仅依赖 HTTP_REFERER 校验，可被 CSRF 绕过实现账户接管\n\n024.php 的密码修改逻辑在 024.php:3 通过 `$_GET['Change']` 触发，在 024.php:5 仅用 `stripos($_SERVER['HTTP_REFERER'], $_SERVER['SERVER_NAME']) !== false` 判断请求来源。HTTP_REFERER 完全由客户端控制，攻击者可在自己的页面中把 Referer 伪造成包含目标域名的字符串（例如 `http://TARGET/` 或 `http://evil.com/?TARGET`），从而通过该“防护”。通过后 024.php:7-8 直接读取 `password_new`/`password_conf`，024.php:11 仅比较两者相等，024.php:14 做 md5，024.php:18 拼接 UPDATE 语句，024.php:19 执行更新当前用户密码。整个流程没有任何 CSRF token、没有要求提交旧密码、没有二次确认，攻击者诱导已登录受害者访问恶意页面即可把受害者密码改成攻击者已知值，实现账户接管。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "024.php"
                },
                "region": {
                  "startLine": 3,
                  "endLine": 19
                }
              }
            }
          ],
