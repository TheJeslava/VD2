            "confidence": 0.6,
            "verdict": "candidate",
            "evidence_level": "rule_verified+llm",
            "cwe": "CWE-804",
            "endpoint": "/014",
            "http_method": "ANY",
            "has_poc": true,
            "origin": "rule"
          }
        },
        {
          "ruleId": "sunset/weak_hash",
          "level": "warning",
          "message": {
            "text": "密码使用无盐 MD5 存储（014.php:57）\n\n第 57 行对用户新口令仅做 md5() 后写入 users.password，未使用盐值或 password_hash()/bcrypt/argon2。MD5 计算速度快、易被彩虹表与 GPU 暴力破解，一旦数据库泄露口令可被快速还原。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "014.php"
                },
                "region": {
