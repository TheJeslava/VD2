                  "endLine": 23
                }
              }
            }
          ],
          "partialFingerprints": {
            "sunsetFindingId": "LLM-a618508f9b61"
          },
          "properties": {
            "finding_id": "LLM-a618508f9b61",
            "confidence": 0.9,
            "verdict": "candidate",
            "evidence_level": "llm_inferred",
            "cwe": "CWE-287",
