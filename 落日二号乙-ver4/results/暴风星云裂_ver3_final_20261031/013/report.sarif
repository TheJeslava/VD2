          }
        },
        {
          "ruleId": "sunset/auth_bypass",
          "level": "error",
          "message": {
            "text": "DVWA 密码修改页 CAPTCHA 校验可被伪造请求头绕过（013.php）\n\n013.php 在处理密码修改时，先调用 recaptcha_check_answer 校验第三方 CAPTCHA，但校验条件写成 `$resp || (g-recaptcha-response == 'hidd3n_valu3' && HTTP_USER_AGENT == 'reCAPTCHA')`。攻击者只要把 POST 参数 g-recaptcha-response 设为固定字符串 hidd3n_valu3，并把 User-Agent 头设为 reCAPTCHA，即可让整个 if 条件恒真，完全跳过 CAPTCHA 校验，随后直接进入密码修改逻辑（第 25-31 行），把当前登录用户的密码改为攻击者指定值。这是硬编码的万能口令 + 可伪造请求头构成的认证辅助机制绕过（CWE-287 / CWE-798），属于 DVWA 中已知的 CAPTCHA bypass 场景。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "013.php"
                },
