          }
        },
        {
          "ruleId": "sunset/auth_bypass",
          "level": "error",
          "message": {
            "text": "DVWA 密码修改页 CAPTCHA 校验可被硬编码值 + User-Agent 伪造绕过\n\n013.php 第 17-23 行的 CAPTCHA 校验条件为 `$resp || ($_POST['g-recaptcha-response']=='hidd3n_valu3' && $_SERVER['HTTP_USER_AGENT']=='reCAPTCHA')`。攻击者无需真正通过 reCAPTCHA，只要提交固定字符串 `hidd3n_valu3` 并把 User-Agent 头设为 `reCAPTCHA`，即可让整个条件恒真，进入密码修改分支（第 25-31 行），在仅需已登录会话的情况下把当前用户密码改为任意值。这是硬编码后门式校验，属于认证/校验机制绕过（CWE-287 / CWE-798 硬编码凭据）。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "013.php"
                },
                "region": {
                  "startLine": 17,
                  "endLine": 23
