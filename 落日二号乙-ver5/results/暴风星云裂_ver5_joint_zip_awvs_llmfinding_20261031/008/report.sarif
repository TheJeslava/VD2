        {
          "ruleId": "sunset/idor",
          "level": "error",
          "message": {
            "text": "DVWA BAC 页面通过可篡改 user_id Cookie 越权读取任意用户资料\n\n008.php 的访问控制完全依赖客户端 Cookie `user_id`：第 30-33 行读取 `$_COOKIE['user_id']` 并与请求参数 `$_GET['user_id']` 比较，相等即视为“本人”并放行第 35-47 行的资料查询与回显。Cookie 由攻击者完全控制，只要把 Cookie 的 user_id 改成目标 ID，即可通过 `id == cookie_id` 校验，读取任意用户的 first_name/last_name/avatar。服务端从未用会话中的真实身份（第 7-11 行查出的 $current_user_id）做归属校验，属于典型的水平越权（IDOR）。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "008.php"
                },
                "region": {
                  "startLine": 30,
                  "endLine": 47
                }
              }
            }
