          }
        },
        {
          "ruleId": "sunset/sql_injection",
          "level": "error",
          "message": {
            "text": "008.php 用户信息查询 SQL 注入（CWE-89）\n\n在通过前述校验后，$id 再次被拼入 $query（008.php:35：SELECT first_name, last_name, user_id, avatar FROM users WHERE user_id = $id;），并在 008.php:36 由 mysqli_query 执行。该处同样无参数化、无转义，攻击者可用 UNION SELECT 追加任意列或子查询，把结果集替换为攻击者控制的数据。"
          },
          "locations": [
