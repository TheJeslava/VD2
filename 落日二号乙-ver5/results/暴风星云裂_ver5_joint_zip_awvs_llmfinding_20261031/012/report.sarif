            "confidence": 0.73,
            "verdict": "candidate",
            "evidence_level": "rule_verified+llm",
            "cwe": "CWE-89",
            "endpoint": "/012",
            "http_method": "GET",
            "has_poc": true,
            "origin": "rule"
          }
        },
        {
          "ruleId": "sunset/brute_force",
          "level": "error",
          "message": {
            "text": "012.php 登录接口缺少暴力破解防护（CWE-307）\n\n012.php:3 通过 if(isset($_GET['Login'])) 暴露登录处理流程，随后在 012.php:14-15 校验用户名/口令。代码中未见失败次数计数、账户锁定、验证码、延迟或速率限制等任何反暴力破解机制，攻击者可对同一端点无限次提交用户名/口令组合。结合 012.php:11 的 MD5 口令存储与 012.php:15 的 SQL 注入，攻击面进一步放大。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "012.php"
                },
                "region": {
                  "startLine": 2,
                  "endLine": 3
                }
              }
            }
          ],
          "partialFingerprints": {
            "sunsetFindingId": "SEM-536ee862bb25"
          },
          "properties": {
            "finding_id": "SEM-536ee862bb25",
            "confidence": 0.55,
            "verdict": "candidate",
            "evidence_level": "rule_verified+llm",
            "cwe": "CWE-307",
            "endpoint": "/012",
            "http_method": "GET",
            "has_poc": true,
            "origin": "rule"
          }
        },
        {
          "ruleId": "sunset/weak_crypto",
          "level": "warning",
          "message": {
            "text": "012.php 口令使用 MD5 存储（CWE-328 弱哈希）\n\n012.php:11 对登录口令执行 $pass = md5($pass)，即使用无盐 MD5 处理用户口令（012.php:10 先做 mysqli_real_escape_string 再哈希）。MD5 属快速、无盐、已被证明存在碰撞的哈希算法，不适合口令等安全用途；攻击者一旦通过 SQL 注入或数据库泄露获取哈希值，可用彩虹表/GPU 暴力快速还原明文。注意此处根因是弱哈希（CWE-328），而非 DES/ECB 类加密算法问题（CWE-327）。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "012.php"
                },
                "region": {
                  "startLine": 10,
                  "endLine": 11
                }
              }
            }
          ],
