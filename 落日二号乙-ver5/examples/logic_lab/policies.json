{
  "version": 1,
  "rules": [
    {
      "id": "vulnerable-reset_password",
      "category": "workflow_bypass",
      "file": "vulnerable.py",
      "function": "reset_password",
      "operation": "store.change_password",
      "required_condition": "session.get('captcha_passed') is True",
      "description": "修改密码前必须由服务端记录当前会话已通过验证；仅针对本次操作。",
      "trusted_inputs": [
        "session"
      ],
      "context_complete": true
    },
    {
      "id": "vulnerable-reset_password_client_flag",
      "category": "workflow_bypass",
      "file": "vulnerable.py",
      "function": "reset_password_client_flag",
      "operation": "store.change_password",
      "required_condition": "session.get('captcha_passed') is True",
      "description": "修改密码前必须检查服务端验证状态，不能信任请求中的 passed_captcha。",
      "trusted_inputs": [
        "session"
      ],
      "context_complete": true
    },
    {
      "id": "vulnerable-update_order",
      "category": "object_authorization",
      "file": "vulnerable.py",
      "function": "update_order",
      "operation": "store.update_order",
      "required_condition": "order['owner_id'] == session['user_id']",
      "description": "本实验禁止用户修改其他用户的订单；服务端身份与持久化订单归属必须相同。",
      "trusted_inputs": [
        "session",
        "order"
      ],
      "context_complete": true,
      "operation_bindings": {
        "0": "order['id']"
      }
    },
    {
      "id": "vulnerable-purchase",
      "category": "business_constraint",
      "file": "vulnerable.py",
      "function": "purchase",
      "operation": "store.purchase",
      "required_condition": "quantity > 0",
      "description": "本实验购买数量必须为正整数；传输层验证整数类型，本规则验证正数边界。",
      "trusted_inputs": [],
      "context_complete": true,
      "operation_bindings": {
        "1": "quantity"
      }
    },
    {
