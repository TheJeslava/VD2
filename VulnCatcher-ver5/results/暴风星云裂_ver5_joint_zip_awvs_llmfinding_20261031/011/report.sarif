      "results": [
        {
          "ruleId": "sunset/sql_injection",
          "level": "error",
          "message": {
            "text": "011.php 登录接口 username 参数 SQL 注入（可绕过认证并拖库）\n\n011.php 第 3 行通过 $_GET['Login'] 触发登录分支，第 5 行直接取 $_GET['username'] 赋给 $user，未做任何转义/参数化；第 12 行把 $user 直接拼接进 SELECT 语句，第 13 行交给 mysqli_query 执行。password 虽经 md5() 处理（第 9 行），但 username 完全可控，攻击者可用 ' OR '1'='1 之类的 payload 改变 SQL 语法，绕过密码校验以任意用户（含管理员）身份登录，或用 UNION/布尔/报错注入读取 users 表全部数据。第 13 行的 die(mysqli_error(...)) 还会把数据库错误回显到页面，构成报错注入通道。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "011.php"
                },
                "region": {
                  "startLine": 5,
                  "endLine": 13
                }
              }
            }
          ],
          "partialFingerprints": {
            "sunsetFindingId": "LLM-c969ca7950b6"
          },
          "properties": {
            "finding_id": "LLM-c969ca7950b6",
            "confidence": 0.95,
            "verdict": "candidate",
            "evidence_level": "llm_inferred",
            "cwe": "CWE-89",
            "endpoint": "/011.php",
            "http_method": "GET",
            "has_poc": true,
            "origin": "llm_finding"
          }
        },
        {
          "ruleId": "sunset/brute_force",
          "level": "error",
          "message": {
            "text": "011.php 登录接口缺少暴力破解防护（CWE-307）\n\n011.php:3 通过 isset($_GET['Login']) 进入登录流程，读取 username/password 并查询数据库，但代码中未见失败计数、账户锁定、验证码、延迟或速率限制。攻击者可对同一接口高频提交用户名/口令组合进行在线爆破。需说明：该结论基于源码静态观察，未做运行时验证；且由于 GEN-1a5cef9ca4a7 的 SQL 注入可绕过认证，爆破的实际必要性下降，但防护缺失本身仍成立。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "011.php"
                },
                "region": {
                  "startLine": 2,
                  "endLine": 3
                }
              }
            }
          ],
          "partialFingerprints": {
            "sunsetFindingId": "SEM-bb3630458a80"
          },
          "properties": {
            "finding_id": "SEM-bb3630458a80",
            "confidence": 0.4,
            "verdict": "candidate",
            "evidence_level": "rule_verified+llm",
            "cwe": "CWE-307",
            "endpoint": "/011",
            "http_method": "GET",
            "has_poc": true,
            "origin": "rule"
          }
        },
        {
          "ruleId": "sunset/weak_crypto",
          "level": "warning",
          "message": {
            "text": "011.php 口令使用 MD5 哈希（CWE-328）\n\n011.php:8 从 $_GET['password'] 读取口令，011.php:9 直接调用 md5($pass) 生成摘要，并在 011.php:12 的 SQL 中与数据库存储值比较。MD5 为快速、无盐、无迭代的弱哈希，用于口令存储/校验属不安全实现；攻击者获取数据库后可借助彩虹表或 GPU 高速碰撞还原口令。注意：此处是哈希算法强度问题（CWE-328），不是加密算法模式问题。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "011.php"
                },
                "region": {
