        },
        {
          "ruleId": "sunset/command_injection",
          "level": "error",
          "message": {
            "text": "027.php Windows 分支 ping 命令拼接导致 OS 命令注入（CWE-78）\n\n攻击者通过 HTTP 查询参数 `ip` 提供输入，该输入在 027.php:5 被读入变量 `target`（证据中 source 标注为 query `ip`）。程序在 027.php:17 用 `stristr(php_uname('s'), 'Windows NT')` 判断运行平台，命中 Windows 分支后，在 027.php:19 将 `target` 直接字符串拼接到 `shell_exec('ping  ' . $target)` 中执行。代码片段显示拼接前没有任何转义、白名单或参数化处理（无 escapeshellarg/escapeshellcmd、无 IP 格式校验），因此 `target` 中的 shell 元字符（如 `&`、`|`、`;`）会被命令解释器当作命令分隔符执行，校验完全失效。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "027.php"
                },
                "region": {
                  "startLine": 17,
                  "endLine": 19
