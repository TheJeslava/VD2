        {
          "ruleId": "sunset/auth_bypass",
          "level": "error",
          "message": {
            "text": "058_08.php 密码修改页仅凭客户端可控 Cookie Auth=1 即通过认证，导致任意用户密码重置（账户接管）\n\n058_08.php 的访问控制只检查 `isset($_COOKIE[\"Auth\"])`（第 7 行），而该 Cookie 在 058_06.php 第 44 行由服务端以固定值 1 下发、无签名无校验。攻击者无需登录，只要在请求中手工带上 `Cookie: Auth=1` 即可通过第 7-14 行的守卫，进入密码修改逻辑。随后第 31 行 `$username = $_SESSION[\"username\"]` 取当前会话用户名，第 38 行构造 `UPDATE users SET PASSWORD='$pass' where username='$username' and password='$curr_pass'`。由于守卫不校验会话身份，攻击者可用自己注册/已知的账号建立会话（或直接利用会话固定），再借 Cookie 绕过进入改密页；更关键的是守卫逻辑本身把「是否已认证」完全交给客户端 Cookie，属于典型的信任边界错误，可导致对任意已登录会话的密码修改流程被未授权触发。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "058_08.php"
                },
                "region": {
                  "startLine": 7,
                  "endLine": 14
                }
              }
            }
          ],
          "partialFingerprints": {
            "sunsetFindingId": "LLM-294d609e1b45"
          },
          "properties": {
            "finding_id": "LLM-294d609e1b45",
            "confidence": 0.72,
            "verdict": "candidate",
            "evidence_level": "llm_inferred",
            "cwe": "CWE-287",
            "endpoint": "/058_08.php",
            "http_method": "POST",
            "has_poc": true,
            "origin": "llm_finding"
          }
        },
        {
          "ruleId": "sunset/weak_id",
          "level": "error",
          "message": {
            "text": "058_06.php 认证 Cookie 使用固定值且缺少安全属性（CWE-330/CWE-565）\n\n058_06.php:43-44 在登录成功后设置 $_SESSION[\"username\"] 并执行 setcookie(\"Auth\", 1, time()+3600)，即认证标志 Auth 恒为常量 1，且未设置 HttpOnly/Secure/SameSite 属性。该 Cookie 不携带不可预测的会话标识，任何能设置同名 Cookie 的客户端都可伪造认证状态（取决于服务端是否仅以 Auth 存在性判定登录）。"
          },
          "locations": [
