          }
        },
        {
          "ruleId": "sunset/brute_force",
          "level": "error",
          "message": {
            "text": "024.php 口令修改接口缺乏速率限制/失败锁定（CWE-307）\n\n024.php:6-8 直接读取 GET 参数 password_new / password_conf 并进入修改口令流程，代码中未见失败计数、账户锁定、验证码或速率限制逻辑。需说明的缺口：该脚本本身是“修改口令”而非“登录”流程，候选将其标注为暴力破解防护缺失，但输入片段中未给出登录校验代码，无法确认是否存在可被反复猜测的认证判定点；因此该结论证据不足，仅能指出 024.php:6-8 缺少任何请求频度控制。"
          },
