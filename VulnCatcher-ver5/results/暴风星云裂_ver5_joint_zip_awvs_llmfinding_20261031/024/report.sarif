            "confidence": 0.63,
            "verdict": "candidate",
            "evidence_level": "rule_verified+llm",
            "cwe": "CWE-89",
            "endpoint": "/024",
            "http_method": "GET",
            "has_poc": true,
            "origin": "rule"
          }
        },
        {
          "ruleId": "sunset/csrf",
          "level": "error",
          "message": {
            "text": "DVWA 密码修改功能仅依赖 HTTP_REFERER 校验，可被 CSRF 绕过并接管账户\n\n024.php 的密码修改逻辑在 `isset($_GET['Change'])` 时执行，仅通过 `stripos($_SERVER['HTTP_REFERER'], $_SERVER['SERVER_NAME']) !== false` 判断请求来源。HTTP_REFERER 完全由客户端控制，攻击者可构造包含目标域名的 Referer（或利用浏览器策略/子串匹配缺陷）绕过该校验；同时该操作使用 GET 方法、无 CSRF token、无当前密码确认，攻击者诱导已登录受害者访问恶意页面即可把受害者密码改为攻击者指定值，导致账户接管。此外 `stripos` 子串匹配可被 `http://attacker.com/?TARGET_HOST` 形式的 Referer 欺骗。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "024.php"
                },
                "region": {
                  "startLine": 3,
                  "endLine": 19
                }
              }
            }
          ],
          "partialFingerprints": {
