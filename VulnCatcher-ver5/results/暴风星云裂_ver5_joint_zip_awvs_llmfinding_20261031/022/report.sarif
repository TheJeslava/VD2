          },
          "properties": {
            "finding_id": "GEN-e38e01cf9ba5",
            "confidence": 0.68,
            "verdict": "candidate",
            "evidence_level": "rule_verified+llm",
            "cwe": "CWE-89",
            "endpoint": "/022",
            "http_method": "ANY",
            "has_poc": true,
            "origin": "rule"
          }
        },
        {
          "ruleId": "sunset/path_traversal",
          "level": "error",
          "message": {
            "text": "022.php JSON 请求体解析处的路径穿越候选（CWE-22）\n\n候选将 022.php:8 的 $data = json_decode(file_get_contents('php://input'), true); 标记为 path_traversal 汇点。经复核，file_get_contents 的参数是固定伪协议字符串 'php://input'，并非由外部输入拼接而成，攻击者无法通过请求体改变被读取的路径；json_decode 的返回值 $data 在给出的代码片段（022.php:6-8）中未见被用于文件路径拼接。因此该候选的 source→sink 链条不成立：外部输入（请求体）进入的是 JSON 解析器，而非文件系统路径。证据不足，无法确认为路径穿越。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "022.php"
                },
                "region": {
                  "startLine": 6,
                  "endLine": 8
                }
              }
            }
          ],
