            "confidence": 0.4,
            "verdict": "candidate",
            "evidence_level": "rule_verified+llm",
            "cwe": "CWE-89",
            "endpoint": "/023",
            "http_method": "GET",
            "has_poc": true,
            "origin": "rule"
          }
        },
        {
          "ruleId": "sunset/csrf",
          "level": "error",
          "message": {
            "text": "DVWA 密码修改功能（023.php）缺少 CSRF token，可被跨站强制修改受害者密码导致账户接管\n\n023.php 在 `$_GET['Change']` 存在时直接读取 `password_new` 与 `password_conf`，仅校验两者相等（第 9 行），随后经 mysqli_real_escape_string + md5 后拼入 UPDATE 语句（第 16-17 行）修改当前登录用户密码。整个流程没有任何 CSRF token、Referer 校验、原密码确认或二次认证，且接受 GET 请求，因此攻击者只需诱导已登录受害者访问一个携带 `Change=Change&password_new=X&password_conf=X` 的链接/图片即可把受害者密码改为攻击者已知值，进而接管账户。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "023.php"
                },
                "region": {
                  "startLine": 3,
                  "endLine": 17
                }
              }
            }
          ],
          "partialFingerprints": {
