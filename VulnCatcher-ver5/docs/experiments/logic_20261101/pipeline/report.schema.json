{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunset-one.local/schema/report-1.0.json",
  "title": "落日二号结构化漏洞报告",
  "type": "object",
  "required": [
    "schema_version",
    "generator",
    "run",
    "project",
    "summary",
    "findings",
    "second_order",
    "security",
    "awvs",
    "coverage",
    "llm",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "generator": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "run": {
      "type": "object",
      "required": [
        "run_id",
        "generated_at",
        "zip_path",
        "zip_sha256"
      ],
      "properties": {
        "run_id": {
          "type": "string"
        },
        "generated_at": {
          "type": "string"
        },
        "zip_path": {
          "type": "string"
        },
        "zip_sha256": {
          "type": "string"
        },
        "duration_sec": {
          "type": "number"
        }
      }
    },
    "project": {
      "type": "object",
      "required": [
        "file_count",
        "languages",
        "frameworks",
        "endpoint_count"
      ],
      "properties": {
        "file_count": {
          "type": "integer"
        },
        "text_file_count": {
          "type": "integer"
        },
        "languages": {
          "type": "object"
        },
        "frameworks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "endpoint_count": {
          "type": "integer"
        },
        "endpoints": {
          "type": "array"
        },
        "files": {
          "type": "array"
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "total_findings",
        "with_poc",
        "by_severity",
        "by_verdict",
        "by_evidence_level"
      ],
      "properties": {
        "total_findings": {
          "type": "integer"
        },
        "with_poc": {
          "type": "integer"
        },
        "by_severity": {
          "type": "object"
        },
        "by_verdict": {
          "type": "object"
        },
        "by_evidence_level": {
          "type": "object"
        },
        "second_order": {
          "type": "integer"
        },
        "injection_signals": {
          "type": "integer"
        },
        "quarantined_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "vulnerability_type",
          "cwe",
          "severity",
          "confidence",
          "verdict",
          "evidence_level",
          "location",
          "exploit_chain",
          "poc",
          "safety"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "vulnerability_type": {
            "type": "string"
          },
          "cwe": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "cvss_estimate": {
            "type": "number"
          },
          "confidence": {
            "type": "number"
          },
          "verdict": {
            "type": "string"
          },
          "evidence_level": {
            "type": "string"
          },
          "location": {
            "type": "object"
          },
          "exploit_chain": {
            "type": "array"
          },
          "poc": {
            "type": "object"
          },
          "safety": {
            "type": "object"
          }
        }
      }
    },
    "second_order": {
      "type": "array"
    },
    "logic_assessments": {
      "type": "array"
    },
    "security": {
      "type": "object"
    },
    "awvs": {
      "type": "object"
    },
    "coverage": {
      "type": "object"
    },
    "policy": {
      "type": "object"
    },
    "llm": {
      "type": "object"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}