            "verdict": "candidate",
            "evidence_level": "rule_verified+llm",
            "cwe": "CWE-434",
            "endpoint": "/044",
            "http_method": "ANY",
            "has_poc": true,
            "origin": "rule"
          }
        },
        {
          "ruleId": "sunset/file_upload",
          "level": "error",
          "message": {
            "text": "DVWA 044.php 无限制文件上传导致任意 PHP 文件写入 Web 目录（RCE）\n\n044.php 在收到 POST 参数 Upload 时，直接取 $_FILES['uploaded']['name'] 经 basename() 处理后拼接到 DVWA_WEB_PAGE_TO_ROOT.\"hackable/uploads/\" 目录，并调用 move_uploaded_file() 落盘。全程没有扩展名白名单、MIME 校验、getimagesize 检查、文件大小限制或随机重命名，攻击者可上传 .php 文件到 Web 可访问目录并直接请求执行，形成远程代码执行。"
          },
          "locations": [
