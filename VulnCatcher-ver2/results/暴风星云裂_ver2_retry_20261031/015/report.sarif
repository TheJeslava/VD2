          },
          "properties": {
            "finding_id": "GEN-c00a42452f04",
            "confidence": 0.4,
            "verdict": "candidate",
            "evidence_level": "rule_verified+llm",
            "cwe": "CWE-89",
            "endpoint": "/015",
            "http_method": "ANY",
            "has_poc": true,
            "origin": "rule"
          }
        },
        {
          "ruleId": "sunset/auth_bypass",
          "level": "error",
          "message": {
            "text": "DVWA 密码修改功能 CAPTCHA 校验可被绕过（step=2 直接提交 passed_captcha=true）\n\n015.php 的密码修改流程分为两步：step=1 时调用 recaptcha_check_answer 校验 CAPTCHA，通过后渲染一个隐藏表单，其中包含 step=2、password_new、password_conf、passed_captcha=true。step=2 分支（第 46-81 行）仅检查 $_POST['passed_captcha'] 是否为真（第 55 行），完全不重新校验 CAPTCHA，也不校验该值是否由服务端签发。攻击者可直接构造 step=2 请求并携带 passed_captcha=true，跳过 CAPTCHA 校验，直接进入密码更新逻辑（第 62-69 行），将当前登录用户的密码改为任意值。这使 CAPTCHA 这一反自动化/防暴力破解机制完全失效，可被脚本化批量利用。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "015.php"
                },
                "region": {
