          "ruleId": "sunset/xss",
          "level": "error",
          "message": {
            "text": "020.php POST 参数 include 未编码直接拼入 <script src> 导致反射型 XSS（CSP 白名单可绕过）\n\n020.php 第 13-17 行读取 $_POST['include']，未做任何 HTML 实体编码或 URL 白名单校验，直接以单引号包裹拼入 <script src='...'></script> 并输出到页面。攻击者可注入单引号闭合 src 属性，插入任意 HTML/事件处理器（如 onerror、onload）或额外 <script> 标签，实现反射型 XSS。页面虽在第 3-5 行设置了 CSP（script-src 白名单），但白名单包含 unpkg.com、cdn.jsdelivr.net、pastebin.com 等可托管任意 JS 的公共 CDN，且注入点本身允许内联事件属性（CSP 未设置 script-src-attr 'none'，也未使用 nonce/hash），因此 CSP 无法阻止利用。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "020.php"
                },
                "region": {
                  "startLine": 13,
                  "endLine": 17
