            "endpoint": "/038",
            "http_method": "ANY",
            "has_poc": true,
            "origin": "rule"
          }
        },
        {
          "ruleId": "sunset/sql_injection",
          "level": "error",
          "message": {
            "text": "DVWA SQL 注入（038.php）：GET 参数 id 直接拼接进 mysqli/SQLite 查询\n\n038.php 在 isset($_GET['Submit']) 时读取 $_GET['id']（第 5 行），未做任何类型转换、转义或参数化，直接以单引号包裹拼入 SQL 语句（第 11 行 MySQL 分支、第 32 行 SQLite 分支），随后分别交给 mysqli_query（第 13 行）与 $sqlite_db_connection->query（第 34 行）执行。攻击者可通过闭合单引号注入任意 SQL，读取 users 表以外的数据（如用户名口令哈希），并借助第 44-52 行的布尔回显（存在/不存在）与 404 状态差异做布尔盲注。"
          },
          "locations": [
            {
              "physicalLocation": {
