            "confidence": 0.85,
            "verdict": "candidate",
            "evidence_level": "llm_inferred",
            "cwe": "CWE-22",
            "endpoint": "/vulnerabilities/view_help.php",
            "http_method": "GET",
            "has_poc": true,
            "origin": "llm_finding"
          }
        },
        {
          "ruleId": "sunset/sql_injection",
          "level": "error",
          "message": {
            "text": "二次 SQL 注入：session-input.php 写入 $_SESSION['id']，sqli 模块读取后拼入查询\n\nsession-input.php 第 12 行将 $_POST['id'] 原样写入 $_SESSION['id']（存储写点），无任何过滤；sqli 模块在 low 档从会话中取出该值（存储读点）并拼入 SQL 查询（危险汇点）。攻击者先通过 session-input.php 存入恶意载荷，再访问 sqli 模块触发注入，绕过仅针对单次请求参数的检查。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "vulnerabilities/sqli/session-input.php"
                },
                "region": {
                  "startLine": 11,
                  "endLine": 14
                }
              }
            }
          ],
