      "results": [
        {
          "ruleId": "sunset/sql_injection",
          "level": "error",
          "message": {
            "text": "DVWA sqli low 等级：$_REQUEST['id'] 直接拼接进 SELECT 查询导致 SQL 注入\n\n脚本在 isset($_REQUEST['Submit']) 成立时，直接把 $_REQUEST['id'] 赋给 $id（第 5 行），随后在第 10 行以单引号包裹的方式拼入 SQL 语句 \"SELECT first_name, last_name FROM users WHERE user_id = '$id';\"，未做任何转义、类型转换或参数化。攻击者可通过 id 参数闭合单引号并注入任意 SQL（UNION 联合查询、布尔/时间盲注、堆叠查询视驱动而定），读取 users 表乃至数据库内其它数据。第 11 行在查询失败时通过 die() 回显 mysqli_error，构成基于报错的注入确认与数据外带通道。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "sqli/source/low.php"
                },
                "region": {
                  "startLine": 5,
                  "endLine": 11
                }
              }
            }
          ],
