      "results": [
        {
          "ruleId": "sunset/sql_injection",
          "level": "error",
          "message": {
            "text": "DVWA SQL 注入：$_REQUEST['id'] 直接拼接进 SELECT 语句（MySQL/SQLite 双分支）\n\n041.php 在 isset($_REQUEST['Submit']) 成立时，直接把 $_REQUEST['id'] 赋给 $id（第5行），未做任何类型转换、转义或参数化，随后在第10行（MYSQL 分支）与第31行（SQLITE 分支）以单引号包裹方式拼接进 SELECT 语句，并分别交给 mysqli_query（第11行）与 SQLite3::query（第34行）执行。攻击者可通过 id 参数闭合单引号注入任意 SQL，读取 users 表以外的数据（如 dvwa 库中的 users/password 哈希），并借助第11行 die(mysqli_error(...)) 的错误回显进行报错注入与盲注。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "041.php"
                },
                "region": {
                  "startLine": 5,
                  "endLine": 11
                }
              }
            }
          ],
          "partialFingerprints": {
            "sunsetFindingId": "LLM-d2344e4ce96f"
          },
          "properties": {
            "finding_id": "LLM-d2344e4ce96f",
