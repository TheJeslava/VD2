      "results": [
        {
          "ruleId": "sunset/sql_injection",
          "level": "error",
          "message": {
            "text": "DVWA SQL 注入页 038.php 中 `id` 参数直接拼接进 SQL 查询（MySQL/SQLite 双分支）\n\n038.php 在 `isset($_GET['Submit'])` 成立时，直接把 `$_GET['id']` 赋给 `$id`（第 5 行），未做任何类型转换、转义或参数化，随后在第 11 行（MYSQL 分支）与第 32 行（SQLITE 分支）以单引号包裹方式拼进 `SELECT first_name, last_name FROM users WHERE user_id = '$id';`，分别交给 `mysqli_query()`（第 13 行）与 `$sqlite_db_connection->query()`（第 34 行）执行。攻击者可通过闭合单引号注入任意 SQL 片段，读取 users 表全部数据、联合查询其他表，或基于第 44-52 行的“User ID exists / MISSING”布尔差异做盲注。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "038.php"
                },
                "region": {
                  "startLine": 5,
                  "endLine": 13
                }
              }
            }
          ],
