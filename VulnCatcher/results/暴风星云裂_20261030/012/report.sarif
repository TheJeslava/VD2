      "results": [
        {
          "ruleId": "sunset/sql_injection",
          "level": "error",
          "message": {
            "text": "012.php 登录接口 username 参数经 mysqli_real_escape_string 后仍拼接进 SQL 导致注入\n\n012.php 第 3 行判断 $_GET['Login'] 存在即进入登录逻辑；第 5 行从 $_GET['username'] 取用户输入，第 6 行调用 mysqli_real_escape_string 转义，第 14 行将 $user 直接拼接进 SELECT 语句，第 15 行 mysqli_query 执行。转义函数本身依赖连接字符集（$GLOBALS['___mysqli_ston']），在 GBK 等宽字节字符集下可被 %df%27 类宽字节注入绕过；同时第 9-11 行 password 被 md5 处理，但 username 未做参数化，仍构成注入点。攻击者可通过构造 username 闭合引号，绕过登录校验或读取 users 表数据。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "012.php"
                },
                "region": {
                  "startLine": 5,
                  "endLine": 15
                }
              }
            }
          ],
          "partialFingerprints": {
            "sunsetFindingId": "LLM-0f1e01503c6f"
          },
          "properties": {
            "finding_id": "LLM-0f1e01503c6f",
            "confidence": 0.4,
            "verdict": "candidate",
            "evidence_level": "llm_inferred",
            "cwe": "CWE-89",
            "endpoint": "/012.php",
            "http_method": "GET",
            "has_poc": true,
            "origin": "llm_finding"
          }
        }
      ]
    }
