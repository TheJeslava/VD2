      "results": [
        {
          "ruleId": "sunset/sql_injection",
          "level": "error",
          "message": {
            "text": "DVWA SQL Injection（low 级别）——$_SESSION['id'] 直接拼接进 SQL 查询\n\n040.php 从 $_SESSION['id'] 取值后未做任何转义/参数化，直接以字符串插值方式拼进 SELECT 语句（第 10 行 MySQL 分支、第 28 行 SQLite 分支），随后交给 mysqli_query / SQLite3::query 执行。攻击者只要能控制会话中的 id（例如通过 DVWA 的 SQL Injection 页面把 payload 写入会话，或存在会话注入/固定），即可闭合单引号注入任意 SQL，读取 users 表以外的数据（如 dvwa.users 口令哈希、information_schema），在 MySQL 高权限下还可进一步 UNION 读取文件或写文件。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "040.php"
                },
                "region": {
                  "startLine": 5,
                  "endLine": 11
                }
              }
            }
          ],
          "partialFingerprints": {
