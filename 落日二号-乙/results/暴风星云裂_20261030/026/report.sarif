        {
          "ruleId": "sunset/command_injection",
          "level": "error",
          "message": {
            "text": "026.php ping 表单参数 ip 未过滤直接拼接进 shell_exec 导致远程命令执行\n\n026.php 在收到 POST 参数 Submit 后，从 $_REQUEST['ip'] 读取用户输入（第 5 行），未做任何白名单、转义（escapeshellarg/escapeshellcmd）或类型校验，直接以字符串拼接方式传入 shell_exec('ping -c 4 ' . $target)（*nix，第 14 行）或 shell_exec('ping  ' . $target)（Windows，第 10 行）。攻击者可在 ip 参数中注入 shell 元字符（;、|、&&、$()、反引号）执行任意系统命令，命令输出经 $cmd 回显到页面 <pre> 中（第 18 行），形成完整的回显型 RCE。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "026.php"
                },
                "region": {
                  "startLine": 5,
                  "endLine": 14
                }
              }
            }
          ],
