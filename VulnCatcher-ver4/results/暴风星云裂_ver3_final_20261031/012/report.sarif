            "evidence_level": "rule_verified+llm",
            "cwe": "CWE-89",
            "endpoint": "/012",
            "http_method": "ANY",
            "has_poc": true,
            "origin": "rule"
          }
        },
        {
          "ruleId": "sunset/brute_force",
          "level": "error",
          "message": {
            "text": "012.php 登录接口缺少暴力破解防护（CWE-307）\n\n012.php:3 以 `if( isset( $_GET[ 'Login' ] ) ) {` 进入登录处理流程，随后读取用户名/口令并执行查询。代码中未见失败次数计数、账号/IP 锁定、验证码、指数退避或速率限制等任何反暴力破解机制，攻击者可对同一账号无限次提交口令猜测。该弱点与同文件的 MD5 无盐哈希（012.php:11）叠加，进一步降低猜测与离线破解成本。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "012.php"
                },
                "region": {
                  "startLine": 2,
                  "endLine": 3
                }
              }
            }
          ],
          "partialFingerprints": {
            "sunsetFindingId": "SEM-536ee862bb25"
          },
          "properties": {
            "finding_id": "SEM-536ee862bb25",
            "confidence": 0.55,
            "verdict": "candidate",
            "evidence_level": "rule_verified+llm",
            "cwe": "CWE-307",
            "endpoint": "/012",
            "http_method": "ANY",
            "has_poc": true,
            "origin": "rule"
          }
        },
        {
          "ruleId": "sunset/weak_crypto",
          "level": "warning",
          "message": {
            "text": "012.php 使用 MD5 处理口令（CWE-328 弱哈希）\n\n012.php:11 执行 `$pass = md5( $pass );`，将用户提交的口令（012.php:10 经 `mysqli_real_escape_string` 处理后）以无盐 MD5 单轮哈希形式参与后续登录查询。MD5 属已破译的快速哈希算法，无盐、无迭代、无工作因子，无法抵抗离线暴力破解与彩虹表攻击。注意：该弱点本质是弱哈希（CWE-328），而非弱加密算法（CWE-327）。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "012.php"
                },
