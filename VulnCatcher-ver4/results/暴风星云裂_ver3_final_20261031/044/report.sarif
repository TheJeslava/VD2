            "http_method": "ANY",
            "has_poc": true,
            "origin": "rule"
          }
        },
        {
          "ruleId": "sunset/file_upload",
          "level": "error",
          "message": {
            "text": "DVWA 044.php 无限制文件上传导致任意 PHP 文件写入 uploads 目录（可 RCE）\n\n044.php 在收到 POST 参数 Upload 时，直接取 $_FILES['uploaded']['name'] 经 basename() 处理后拼接到 DVWA_WEB_PAGE_TO_ROOT . \"hackable/uploads/\" 目录，并调用 move_uploaded_file() 将临时文件移动到该路径。代码未校验扩展名、MIME 类型、文件内容，也未做白名单/重命名，攻击者可上传 .php 文件到 Web 可访问的 hackable/uploads/ 目录，随后请求该文件即可执行任意 PHP 代码，形成远程代码执行。"
          },
          "locations": [
