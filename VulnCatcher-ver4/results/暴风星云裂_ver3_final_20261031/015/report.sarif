            "has_poc": true,
            "origin": "llm_finding"
          }
        },
        {
          "ruleId": "sunset/captcha_bypass",
          "level": "error",
          "message": {
            "text": "015.php 验证码流程可绕过（CWE-804）\n\n015.php:3 通过 if( isset($_POST['Change']) && ($_POST['step'] == '1') ) 判断流程阶段，step 完全由客户端 POST 控制。攻击者可直接提交 step=1 及 Change，跳过验证码校验阶段，直接进入密码修改逻辑（015.php:7-9 读取 password_new/password_conf）。片段中未见服务端会话绑定验证码状态或校验验证码答案的逻辑，故客户端可任意推进流程状态。"
          },
