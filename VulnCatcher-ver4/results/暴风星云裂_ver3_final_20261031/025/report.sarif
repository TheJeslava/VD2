      "results": [
        {
          "ruleId": "sunset/command_injection",
          "level": "error",
          "message": {
            "text": "025.php ping 功能通过 $_REQUEST['ip'] 造成命令注入（黑名单可绕过）\n\n025.php 在收到 POST 参数 Submit 后，从 $_REQUEST['ip'] 读取攻击者可控输入 $target，仅用 str_replace 做黑名单替换（过滤 ||、&、;、'| '、-、$、(、)、`），随后直接拼接进 shell_exec('ping -c 4 ' . $target)（Windows 分支为 shell_exec('ping  ' . $target)）。黑名单未过滤换行符 \\n、空格、重定向符 >、<、以及未被列出的管道写法（如 '|' 后不带空格、'||' 被替换后残留等），且 str_replace 是单次替换，可用双写绕过（如 '||' 被替换为空后仍可构造）。攻击者可通过换行符或空格+重定向/管道注入任意系统命令，实现远程代码执行。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "025.php"
                },
                "region": {
                  "startLine": 5,
                  "endLine": 30
                }
              }
            }
          ],
          "partialFingerprints": {
            "sunsetFindingId": "LLM-229f7d2e8603"
          },
          "properties": {
            "finding_id": "LLM-229f7d2e8603",
            "confidence": 0.9,
            "verdict": "candidate",
            "evidence_level": "llm_inferred",
            "cwe": "CWE-78",
            "endpoint": "/025.php",
            "http_method": "POST",
            "has_poc": true,
            "origin": "llm_finding"
          }
        },
        {
          "ruleId": "sunset/command_injection",
          "level": "error",
          "message": {
            "text": "025.php Windows 分支 ping 命令拼接导致 OS 命令注入（CWE-78）\n\n攻击者通过 HTTP 查询参数 `ip` 提供输入，该输入在 025.php:5 被读入变量 `target`，随后未经任何转义或白名单校验，在 025.php:24 判断 `php_uname('s')` 含 'Windows NT' 时进入 Windows 分支，于 025.php:26 直接拼接进 `shell_exec('ping  ' . $target)`。由于 `shell_exec` 将整串交给系统 shell 解释，`target` 中的 `&`、`|`、`&&`、`;` 等元字符会被 shell 当作命令分隔符执行，校验完全缺失，污点直达危险汇点。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "025.php"
                },
                "region": {
                  "startLine": 24,
                  "endLine": 26
                }
              }
            }
          ],
          "partialFingerprints": {
            "sunsetFindingId": "GEN-2da8a6e02c4e"
          },
          "properties": {
            "finding_id": "GEN-2da8a6e02c4e",
            "confidence": 0.83,
            "verdict": "candidate",
            "evidence_level": "rule_verified+llm",
            "cwe": "CWE-78",
            "endpoint": "/025",
            "http_method": "ANY",
            "has_poc": true,
            "origin": "rule"
          }
        }
      ]
