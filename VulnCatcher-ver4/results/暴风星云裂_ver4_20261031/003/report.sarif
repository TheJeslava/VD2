          },
          "properties": {
            "finding_id": "LLM-d891d8de8c0d",
            "confidence": 0.85,
            "verdict": "candidate",
            "evidence_level": "llm_inferred",
            "cwe": "CWE-79",
            "endpoint": "/003.php",
            "http_method": "GET",
            "has_poc": true,
            "origin": "llm_finding"
          }
        },
        {
          "ruleId": "sunset/api_info_disclosure",
          "level": "error",
          "message": {
            "text": "003.php 基于 REQUEST_URI 的路径处理与 API 信息泄露（CWE-200）\n\n证据仅覆盖 003.php 第 3-4 行：第 3 行 `$request_url = $_SERVER['REQUEST_URI'];` 将客户端可控的请求 URI（含路径与查询串）读入变量；第 4 行 `$stripped_url = str_replace(\"/vulnerabilities/api/\", \"\", $request_url);` 仅做一次固定子串删除，未做规范化、未校验前缀、未限制输出字段。攻击者输入点即 HTTP 请求行中的 URI（任意路径/查询串），经 `$_SERVER['REQUEST_URI']` → `$request_url` → `str_replace` → `$stripped_url`。由于 `str_replace` 只删除字面子串且不区分大小写变体、重复出现、URL 编码形式（如 `%2f`、`..%2f`、`//vulnerabilities/api/`），剥离结果仍可能保留攻击者构造的路径片段；同时该变量后续如何被用于路由分发或响应拼装，在给定片段中不可见，因此“信息泄露”的具体汇点（是否回显 `$stripped_url`、是否据此选择 API 资源并返回用户对象字段）证据不足。当前只能确认：该端点以请求 URI 作为唯一输入并做非规范化字符串处理，属于典型的路径/资源标识处理缺陷面，但缺少读取后的危险汇点证据。"
          },
          "locations": [
            {
              "physicalLocation": {
