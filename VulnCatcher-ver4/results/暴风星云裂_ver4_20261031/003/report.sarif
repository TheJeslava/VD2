          "ruleId": "sunset/xss",
          "level": "error",
          "message": {
            "text": "003.php 通过 REQUEST_URI 反射注入 JavaScript 字符串上下文（DOM/反射型 XSS）\n\n003.php 第 3 行读取 $_SERVER['REQUEST_URI']，第 4 行仅用 str_replace 删除固定子串 \"/vulnerabilities/api/\"，未做任何 HTML/JS 编码或白名单校验；第 31 行与第 51 行把 $stripped_url 直接拼接进 <script> 内的单引号 JS 字符串（const url = '\" . $stripped_url . \"/vulnerabilities/api/v2/user/2';）。攻击者可在请求 URI 中注入单引号闭合字符串并插入任意 JS，脚本在受害者浏览器执行，属于反射型 XSS。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "003.php"
                },
                "region": {
                  "startLine": 3,
                  "endLine": 51
                }
              }
            }
          ],
          "partialFingerprints": {
