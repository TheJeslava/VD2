            "origin": "rule"
          }
        },
        {
          "ruleId": "sunset/captcha_bypass",
          "level": "error",
          "message": {
            "text": "DVWA 密码修改页 CAPTCHA 校验可被硬编码值+User-Agent 绕过，导致任意密码重置（CSRF 链）\n\n013.php 在处理 POST Change 时，先调用 recaptcha_check_answer 校验第三方 CAPTCHA，但第 17-23 行的判定条件为 `$resp || ($_POST['g-recaptcha-response']=='hidd3n_valu3' && $_SERVER['HTTP_USER_AGENT']=='reCAPTCHA')`。攻击者只要提交固定字符串 hidd3n_valu3 并把 User-Agent 设为 reCAPTCHA，即可让整个 CAPTCHA 校验短路为真，无需任何真实 reCAPTCHA 令牌。随后第 25 行仅比较两次新密码是否相等，第 26-27 行做 mysqli_real_escape_string + md5，第 30-31 行直接 UPDATE users 表把当前用户密码改为攻击者指定值。由于该页面没有校验 CSRF token（第 52-53 行的 generateSessionToken 只在渲染表单时生成，处理分支未验证），攻击者可构造一个自动提交的跨站表单，诱导已登录受害者浏览器提交，从而在受害者不知情下重置其密码，实现账户接管。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "013.php"
                },
                "region": {
