            "http_method": "GET",
            "has_poc": true,
            "origin": "rule"
          }
        },
        {
          "ruleId": "sunset/csrf",
          "level": "error",
          "message": {
            "text": "DVWA 密码修改接口（023.php）缺少 CSRF token，可被跨站强制改密导致账户接管\n\n023.php 在 `isset($_GET['Change'])` 成立时直接读取 `$_GET['password_new']` 与 `$_GET['password_conf']`，仅校验两次输入相等（第 9 行），随后做 mysqli_real_escape_string + md5（第 11-12 行），并以 `dvwaCurrentUser()` 拼出 UPDATE 语句更新当前用户密码（第 15-17 行）。整个流程没有任何 CSRF token、Referer/Origin 校验、二次确认或旧密码校验，且使用 GET 方法，攻击者只需诱导已登录受害者在浏览器中访问一个含 `<img src=...>` 的页面即可在受害者会话下完成改密，随后用自己设定的密码登录接管账户。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "023.php"
                },
                "region": {
                  "startLine": 3,
                  "endLine": 17
                }
              }
            }
          ],
          "partialFingerprints": {
            "sunsetFindingId": "LLM-fb8cc628a9b1"
          },
          "properties": {
            "finding_id": "LLM-fb8cc628a9b1",
            "confidence": 0.9,
            "verdict": "candidate",
            "evidence_level": "llm_inferred",
            "cwe": "CWE-352",
