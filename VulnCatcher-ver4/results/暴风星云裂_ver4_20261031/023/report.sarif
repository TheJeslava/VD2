          }
        },
        {
          "ruleId": "sunset/brute_force",
          "level": "error",
          "message": {
            "text": "023.php 口令修改流程缺少速率限制与失败锁定（CWE-307）\n\n023.php:4-6 直接读取 password_new/password_conf 并进入更新逻辑，代码中未见失败计数、账户锁定、验证码或速率限制机制。攻击者可对同一端点高频重复提交请求，用于口令猜测、枚举或配合 CSRF 进行批量尝试。需说明：本文件片段未包含登录校验逻辑，是否构成完整“暴力破解”取决于同目录其他文件（如 login.php）的会话校验实现，该部分不在本次 code_pack 范围内，属证据缺口。"
          },
