            "has_poc": true,
            "origin": "rule"
          }
        },
        {
          "ruleId": "sunset/sql_injection",
          "level": "error",
          "message": {
            "text": "038.php 用户 ID 查询参数 id 直接拼接进 SQL 语句导致 SQL 注入（DVWA SQL Injection 场景）\n\n脚本在 `isset($_GET['Submit'])` 成立时，直接把 `$_GET['id']` 赋给 `$id`（第 5 行），未做任何类型转换、转义或参数化，随后在第 11 行（MySQL 分支）与第 32 行（SQLite 分支）以单引号包裹方式拼接进 `SELECT first_name, last_name FROM users WHERE user_id = '$id';`，并分别交给 `mysqli_query()`（第 13 行）与 `$sqlite_db_connection->query()`（第 34 行）执行。攻击者可通过闭合单引号注入任意 SQL 片段（如 UNION SELECT 读取其他表、布尔/时间盲注），从而读取数据库中的任意数据（用户表、凭据等）。代码中不存在白名单、`intval()`、`mysqli_real_escape_string()` 或预处理语句，属于典型的 source→sink 直连。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "038.php"
                },
                "region": {
                  "startLine": 5,
                  "endLine": 34
                }
              }
            }
          ],
