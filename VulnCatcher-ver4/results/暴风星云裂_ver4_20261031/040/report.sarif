      "results": [
        {
          "ruleId": "sunset/sql_injection",
          "level": "error",
          "message": {
            "text": "DVWA SQL 注入（040.php）：$_SESSION['id'] 直接拼接进 SQL 查询\n\n040.php 从 $_SESSION['id'] 读取 $id，未做任何转义或参数化，直接以字符串插值方式拼入 SELECT 语句（第 10 行 MySQL 分支、第 28 行 SQLite 分支），随后交给 mysqli_query / SQLite3::query 执行。攻击者只要能控制会话中的 id 值（例如通过同站其它写入 $_SESSION['id'] 的入口、会话固定/会话注入，或该文件被作为 DVWA 的 SQL 注入练习页直接以可控会话访问），即可闭合 SQL 注入链，读取 users 表以外的数据（如 users 口令哈希、information_schema），并可将结果通过第 20/44 行的 $html 回显给攻击者。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "040.php"
                },
                "region": {
