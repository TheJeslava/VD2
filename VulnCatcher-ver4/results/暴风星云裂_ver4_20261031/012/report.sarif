          },
          "properties": {
            "finding_id": "SEM-0ce3358fa05b",
            "confidence": 0.76,
            "verdict": "candidate",
            "evidence_level": "rule_verified+llm",
            "cwe": "CWE-327",
            "endpoint": "/012",
            "http_method": "GET",
            "has_poc": true,
            "origin": "rule"
          }
        },
        {
          "ruleId": "sunset/xss",
          "level": "warning",
          "message": {
            "text": "012.php 登录成功页反射型 XSS：username 参数未转义直接拼入 HTML\n\n012.php 在 `isset($_GET['Login'])` 时读取 `$_GET['username']`（第 5 行），仅用 `mysqli_real_escape_string` 做 SQL 转义（第 6 行），该函数只处理 SQL 特殊字符（引号、反斜杠、NUL 等），对 `<`、`>`、`\"`、`'` 等 HTML 元字符不做任何处理。随后第 23 行将 `$user` 直接插入 `$html .= \"<p>Welcome to the password protected area {$user}</p>\"`，未调用 htmlspecialchars/htmlentities。攻击者可构造带 HTML/JS 的 username，在受害者浏览器中执行脚本，窃取会话或发起钓鱼。触发需要登录成功（`mysqli_num_rows($result) == 1`），因此攻击者需知道有效凭据或诱导已登录用户点击链接。"
          },
