        {
          "ruleId": "sunset/idor",
          "level": "error",
          "message": {
            "text": "DVWA BAC 页面通过可篡改的 user_id Cookie 实现越权访问任意用户资料\n\n008.php 在读取用户资料前，仅将客户端 Cookie `user_id` 与请求参数 `user_id` 做相等比较（第 30-33 行），而 Cookie 完全由攻击者控制。攻击者只需把 Cookie `user_id` 设置为目标用户 ID，并请求相同的 `user_id` 参数，即可通过 `$id == $cookie_id` 校验，读取任意用户的 first_name/last_name/avatar（第 35-47 行）。服务端从未校验当前登录会话与目标用户 ID 的归属关系，属于典型的水平越权（IDOR）。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "008.php"
                },
                "region": {
                  "startLine": 30,
                  "endLine": 47
