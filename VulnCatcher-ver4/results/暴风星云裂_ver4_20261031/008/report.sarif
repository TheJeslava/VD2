            "confidence": 0.68,
            "verdict": "candidate",
            "evidence_level": "rule_verified+llm",
            "cwe": "CWE-89",
            "endpoint": "/008",
            "http_method": "GET",
            "has_poc": true,
            "origin": "rule"
          }
        },
        {
          "ruleId": "sunset/sql_injection",
          "level": "error",
          "message": {
            "text": "008.php 日志写入语句 SQL 注入（CWE-89）\n\n008.php:79-80 构造 INSERT INTO bac_log (user_id, target_id, ip_address) VALUES ({$current_user_id}, {$target_id}, '{$ip}')，其中 {$target_id} 与 {$ip} 均以字符串内插方式进入 SQL，且 $ip 仅用单引号包裹而无转义。$target_id 来源于同一外部 user_id 输入链路（008.php:19 的 $id 派生），$ip 通常取自 REMOTE_ADDR 等请求上下文。由于缺少 mysqli_real_escape_string 或参数绑定，攻击者可通过 target_id 注入数值型载荷，或通过可伪造的 IP 来源（如代理头）注入引号闭合载荷，在 008.php:81 的 mysqli_query 执行时改变语句语义。"
          },
          "locations": [
