      "results": [
        {
          "ruleId": "sunset/sql_injection",
          "level": "error",
          "message": {
            "text": "011.php 登录接口 username 参数 SQL 注入（可绕过认证）\n\n011.php 第 3 行通过 $_GET['Login'] 触发登录逻辑，第 5 行直接取 $_GET['username'] 赋给 $user，未做任何转义或参数化；第 12 行将 $user 直接拼接进 SQL 语句 \"SELECT * FROM `users` WHERE user = '$user' AND password = '$pass';\"，第 13 行交给 mysqli_query 执行。攻击者可在 username 中注入单引号闭合字符串，构造恒真条件（如 ' OR '1'='1' -- -），使查询返回任意一行用户记录，第 15 行 mysqli_num_rows == 1 成立即判定登录成功，从而绕过密码校验进入受保护区域。password 虽经 md5() 处理，但 md5 不是 SQL 转义，无法阻止注入。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "011.php"
                },
                "region": {
                  "startLine": 5,
                  "endLine": 13
                }
              }
            }
          ],
          "partialFingerprints": {
            "sunsetFindingId": "LLM-c969ca7950b6"
          },
          "properties": {
            "finding_id": "LLM-c969ca7950b6",
            "confidence": 0.9,
            "verdict": "candidate",
            "evidence_level": "llm_inferred",
            "cwe": "CWE-89",
            "endpoint": "/011.php",
            "http_method": "GET",
            "has_poc": true,
            "origin": "llm_finding"
          }
        },
        {
          "ruleId": "sunset/brute_force",
          "level": "error",
          "message": {
            "text": "011.php 登录接口缺少暴力破解防护（CWE-307）\n\n011.php:3 通过 if(isset($_GET['Login'])) 进入登录处理流程，随后在 011.php:5 读取 username、011.php:8 读取 password 并执行查询比对。代码中未见失败次数计数、账户锁定、验证码、延迟或速率限制等任何反暴力破解机制，攻击者可对同一接口无限次提交用户名/口令组合进行在线猜测。证据为 011.php:2-3 的登录入口与后续处理逻辑中缺失防护代码；该结论为基于源码的推断，实际速率限制可能由前置代理/WAF 提供，源码内不可见。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "011.php"
                },
                "region": {
                  "startLine": 2,
                  "endLine": 3
                }
              }
            }
          ],
          "partialFingerprints": {
            "sunsetFindingId": "SEM-bb3630458a80"
          },
          "properties": {
            "finding_id": "SEM-bb3630458a80",
            "confidence": 0.4,
            "verdict": "candidate",
            "evidence_level": "rule_verified+llm",
            "cwe": "CWE-307",
            "endpoint": "/011",
            "http_method": "GET",
            "has_poc": true,
            "origin": "rule"
          }
        },
        {
          "ruleId": "sunset/weak_crypto",
          "level": "warning",
          "message": {
            "text": "011.php 口令使用 MD5 哈希（CWE-328）\n\n011.php:8 从 $_GET['password'] 读取明文口令，011.php:9 调用 $pass = md5($pass); 将其转换为 MD5 摘要后用于 011.php:12 的登录比对。MD5 为快速、无盐、已被证明存在碰撞的哈希算法，用于口令存储/校验属不安全实现；攻击者一旦获取数据库中的 MD5 值，可用彩虹表或 GPU 高速爆破还原明文。此处为配置/实现型弱点，不依赖 HTTP 污点链，证据为 011.php:9 的 md5( 调用原文。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "011.php"
                },
