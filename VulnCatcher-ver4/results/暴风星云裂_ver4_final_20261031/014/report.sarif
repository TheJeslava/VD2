            "verdict": "candidate",
            "evidence_level": "rule_verified+llm",
            "cwe": "CWE-89",
            "endpoint": "/014",
            "http_method": "POST",
            "has_poc": true,
            "origin": "rule"
          }
        },
        {
          "ruleId": "sunset/csrf",
          "level": "error",
          "message": {
            "text": "DVWA 密码修改功能（step=2）缺少 CSRF token，可被跨站强制修改受害者密码\n\n014.php 的密码修改流程分为两步：step=1 校验 reCAPTCHA，step=2 直接执行密码更新。第 45 行仅检查 `$_POST['Change']` 与 `$_POST['step']=='2'`，第 50-51 行读取 `password_new`/`password_conf`，第 54 行比较两者相等后，第 56-57 行转义并 md5，第 60-61 行执行 `UPDATE users SET password=... WHERE user=dvwaCurrentUser()`。整个 step=2 分支没有任何 CSRF token、Origin/Referer 校验或二次验证码校验，攻击者只需诱导已登录受害者访问一个自动提交的表单，即可把受害者密码改为攻击者已知值，实现账户接管。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "014.php"
                },
                "region": {
                  "startLine": 45,
                  "endLine": 61
