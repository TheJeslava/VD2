        {
          "ruleId": "sunset/sql_injection",
          "level": "error",
          "message": {
            "text": "008.php 用户存在性检查处 SQL 注入（CWE-89）\n\n攻击者通过 HTTP 请求参数 user_id 提供输入（008.php:19 读取 query `user_id`），该值未做类型转换或参数化即被拼接到字符串 $check_query 中（008.php:22：\"SELECT user_id FROM users WHERE user_id = $id\"），随后在 008.php:23 通过 mysqli_query($GLOBALS[\"___mysqli_ston\"], $check_query) 执行。代码中未见 intval()、mysqli_real_escape_string() 或预处理语句，因此单引号/布尔/联合注入均可闭合原语句。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "008.php"
                },
                "region": {
                  "startLine": 21,
                  "endLine": 23
                }
              }
            }
          ],
          "partialFingerprints": {
            "sunsetFindingId": "GEN-f0aa8e8c7f6b"
          },
          "properties": {
