            "origin": "rule"
          }
        },
        {
          "ruleId": "sunset/idor",
          "level": "error",
          "message": {
            "text": "DVWA BAC 页面 008.php 通过可篡改的 user_id Cookie 实现越权访问任意用户资料\n\n008.php 第 15-19 行从 $_GET['user_id'] 读取目标用户 ID，仅用正则 /^\\d+$/ 校验为纯数字后 intval 转换；第 30-33 行的访问控制完全依赖客户端可控的 $_COOKIE['user_id']，将其 intval 后与请求的 $id 做相等比较，相等即视为「本人」并放行。攻击者只需把 Cookie user_id 改成与 GET 参数相同的任意数字，即可绕过归属校验，读取任意用户的 first_name/last_name/avatar（第 35-47 行）。服务端从未用会话中的真实身份（第 7-11 行查出的 $current_user_id）做比对，属于典型的信任客户端 Cookie 的越权（CWE-639 / CWE-565）。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "008.php"
                },
                "region": {
                  "startLine": 30,
                  "endLine": 47
