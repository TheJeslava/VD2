            "has_poc": true,
            "origin": "llm_finding"
          }
        },
        {
          "ruleId": "sunset/sql_injection",
          "level": "error",
          "message": {
            "text": "008.php 第 7 行 dvwaCurrentUser() 拼接进 SQL 导致注入\n\n008.php 第 7 行将 dvwaCurrentUser() 的返回值直接字符串拼接进 SELECT 语句并在第 8 行 mysqli_query 执行，无参数化、无转义。dvwaCurrentUser() 在 DVWA 中通常取自会话/请求中的用户名，若其值可被攻击者影响（如通过登录名或 Cookie），则构成 SQL 注入（CWE-89）。"
          },
          "locations": [
