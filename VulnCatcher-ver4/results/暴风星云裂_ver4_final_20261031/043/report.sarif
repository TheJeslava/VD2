          "ruleId": "sunset/file_upload",
          "level": "error",
          "message": {
            "text": "043.php 不安全文件上传导致任意文件写入（CWE-434）\n\n攻击者通过 HTTP 上传请求的 `uploaded` 文件字段（043.php:12 读取上传文件，临时路径进入 `$uploaded_tmp`）提交任意内容与文件名的文件。代码在 043.php:20 直接调用 `move_uploaded_file( $uploaded_tmp, $target_path )` 将临时文件移动到 `$target_path`，在给出的片段（043.php:18-20）中未见任何扩展名白名单、MIME 校验、文件内容检查或目标路径规范化/限制。由于校验缺失，攻击者可控制落盘文件名与内容，将可执行脚本（如 .php）写入 Web 可访问目录。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "043.php"
                },
                "region": {
                  "startLine": 18,
                  "endLine": 20
                }
              }
            }
          ],
          "partialFingerprints": {
