        {
          "ruleId": "sunset/sql_injection",
          "level": "error",
          "message": {
            "text": "058_05.php 登录查询 username 参数 SQL 注入（CWE-89）\n\n攻击者通过 HTTP 请求向 058_05.php 提交 query 参数 username（058_05.php:25 读取），该值未经任何转义或参数化即被拼接到 SQL 语句 $sql = \"select count(*) from users where username='$username'\"（058_05.php:30），随后在 058_05.php:31 由 mysql_query($sql) 执行。由于输入被直接放入单引号字符串字面量中，攻击者可闭合引号并注入任意 SQL 片段（如 ' OR '1'='1、UNION SELECT 等），校验完全缺失，污点直达数据库执行汇点。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "058_05.php"
                },
                "region": {
                  "startLine": 29,
                  "endLine": 31
                }
              }
            }
          ],
          "partialFingerprints": {
