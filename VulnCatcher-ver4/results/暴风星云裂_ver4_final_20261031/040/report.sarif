              "name": "SQL 注入",
              "shortDescription": {
                "text": "SQL 注入（CWE-89）"
              },
              "fullDescription": {
                "text": "外部输入以字符串拼接方式进入 SQL 语句，改变查询语义。"
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/89.html",
              "properties": {
                "tags": [
                  "sql_injection",
                  "CWE-89",
                  "security"
                ]
              }
            },
            {
              "id": "sunset/xss",
              "name": "跨站脚本",
              "shortDescription": {
                "text": "跨站脚本（CWE-79）"
              },
              "fullDescription": {
                "text": "外部输入未编码进入 HTML/JS 上下文，可在受害者浏览器执行脚本。"
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/79.html",
              "properties": {
                "tags": [
                  "xss",
                  "CWE-79",
                  "security"
                ]
              }
            }
          ]
        }
      },
