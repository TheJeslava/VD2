            "origin": "rule"
          }
        },
        {
          "ruleId": "sunset/csrf",
          "level": "error",
          "message": {
            "text": "DVWA 密码修改功能（023.php）缺少 CSRF token，可被跨站强制改密导致账户接管\n\n023.php 在 `$_GET['Change']` 存在时直接读取 `password_new`/`password_conf`，仅校验两次输入相等（第 9 行），随后对 `$pass_new` 做 mysqli_real_escape_string 与 md5（第 11-12 行），拼接到 UPDATE 语句（第 16 行）并执行（第 17 行），把当前登录用户（`dvwaCurrentUser()`，第 15 行）的密码改为攻击者指定值。整个流程没有任何 anti-CSRF token、Referer/Origin 校验、原密码确认或二次认证。攻击者只需诱导已登录受害者访问一个自动发起 GET 请求的页面（如 <img> 标签），即可在受害者不知情下把其密码改为攻击者已知的值，随后用新密码登录接管账户。由于改密接口使用 GET 且参数全部在 URL 中，利用门槛极低。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "023.php"
                },
                "region": {
                  "startLine": 3,
                  "endLine": 17
                }
              }
            }
          ],
