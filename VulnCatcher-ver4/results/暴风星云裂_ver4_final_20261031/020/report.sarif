            "evidence_level": "rule_verified+llm",
            "cwe": "CWE-22",
            "endpoint": "/020",
            "http_method": "POST",
            "has_poc": true,
            "origin": "rule"
          }
        },
        {
          "ruleId": "sunset/client_side_validation",
          "level": "error",
          "message": {
            "text": "020.php 依赖外部脚本且服务端未重复校验（CWE-602 客户端校验绕过）\n\n020.php:14-15 将用户可控值作为 `<script src='...'>` 引入外部 JavaScript，页面逻辑依赖该外部脚本完成处理。给定片段中未见服务端对 include 参数的任何独立校验（020.php:13 仅 isset），即安全判断若发生在客户端脚本中，可被攻击者直接构造 POST 请求绕过。需注意：片段内未展示外部脚本的具体校验逻辑，因此“客户端校验”这一语义判断的证据有限。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "020.php"
                },
                "region": {
