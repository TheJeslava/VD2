          }
        },
        {
          "ruleId": "sunset/xss",
          "level": "warning",
          "message": {
            "text": "020.php POST 参数 include 未编码直接拼入 <script src> 导致反射型 XSS / CSP 绕过\n\n020.php 第 13-17 行接收 $_POST['include']，未做任何 HTML 实体编码、URL 校验或白名单过滤，直接以单引号包裹拼入 <script src='...'> 标签并输出到响应体。攻击者可闭合单引号并注入任意 HTML/JS（如 '></script><script>alert(1)</script>），或利用 CSP 白名单域（pastebin.com、unpkg.com、cdn.jsdelivr.net 等）托管恶意脚本实现 CSP 绕过。该页面本身设置了宽松的 script-src 白名单，进一步放大了利用价值。"
          },
          "locations": [
