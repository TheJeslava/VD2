        {
          "ruleId": "sunset/sql_injection",
          "level": "error",
          "message": {
            "text": "009.php 用户存在性检查 SQL 注入（CWE-89）\n\n攻击者通过 HTTP 请求的 query 参数 `user_id` 提供输入，该值在 009.php:17 被读取后赋给变量 `$id`，未经任何转义或参数化，直接在 009.php:21 拼接进 SQL 语句 \"SELECT user_id FROM users WHERE user_id = '$id'\"，并在 009.php:22 通过 mysqli_query($GLOBALS[\"___mysqli_ston\"], $check_query) 执行。由于 `$id` 被单引号包裹但未使用 mysqli_real_escape_string 或预处理语句，攻击者可闭合单引号注入任意 SQL 片段（如 `1' OR '1'='1` 或 UNION 查询）。该查询是后续逻辑（用户是否存在判断）的前置检查，注入结果直接影响分支走向。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "009.php"
                },
                "region": {
                  "startLine": 20,
                  "endLine": 22
                }
              }
            }
          ],
          "partialFingerprints": {
