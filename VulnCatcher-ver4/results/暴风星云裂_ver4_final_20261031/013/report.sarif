          }
        },
        {
          "ruleId": "sunset/csrf",
          "level": "warning",
          "message": {
            "text": "密码修改接口缺少 CSRF token 校验\n\n013.php 第 52-53 行仅在页面渲染时调用 generateSessionToken() 生成 Anti-CSRF token，但第 3-50 行的 POST 处理分支从未读取或校验该 token。攻击者可构造跨站表单，诱导已登录用户提交 password_new/password_conf，从而在受害者不知情下修改其密码。由于 CAPTCHA 分支存在硬编码绕过（见上一条），攻击者可在跨站请求中同时伪造 g-recaptcha-response 与 UA，使 CSRF 攻击无需受害者交互验证码。"
          },
          "locations": [
