      "results": [
        {
          "ruleId": "sunset/sql_injection",
          "level": "error",
          "message": {
            "text": "010.php 登录查询 SQL 注入（CWE-89）\n\n攻击者通过 HTTP 请求向 010.php 提交登录参数，源码在 010.php:8 从请求中读取 username（候选 source 记为 query `username`），该值未经任何转义或参数化即被拼接到 010.php:19 的 SQL 语句 \"SELECT * FROM `users` WHERE user = '$user' AND password = '$pass';\" 中，随后在 010.php:20 由 mysqli_query 执行。虽然 010.php:15 对 $pass 调用了 mysqli_real_escape_string，但 $user 变量在拼接前没有任何对应的转义或白名单校验，因此单引号可闭合 user 字段的字符串字面量，注入任意 SQL 片段（如 ' OR '1'='1 绕过认证，或 UNION 读取其他表）。校验无效的原因是该处采用字符串拼接构造 SQL，而非预处理语句/参数绑定。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "010.php"
                },
                "region": {
                  "startLine": 18,
                  "endLine": 20
                }
              }
            }
          ],
          "partialFingerprints": {
            "sunsetFindingId": "GEN-7034f0a19983"
          },
          "properties": {
            "finding_id": "GEN-7034f0a19983",
            "confidence": 0.7,
            "verdict": "candidate",
            "evidence_level": "rule_verified+llm",
            "cwe": "CWE-89",
            "endpoint": "/010",
            "http_method": "GET",
            "has_poc": true,
            "origin": "rule"
          }
        },
        {
          "ruleId": "sunset/weak_crypto",
          "level": "warning",
          "message": {
            "text": "010.php 口令使用 MD5 哈希（CWE-328 弱哈希）\n\n010.php:16 对登录口令执行 $pass = md5($pass)，即使用 MD5 这一已被证明存在碰撞且计算速度极快的哈希算法处理口令。该值随后在 010.php:19 被拼入 SQL 与数据库中的口令字段比较，说明 MD5 被用于口令存储/校验的安全用途。MD5 无盐、无迭代、无工作因子，攻击者一旦获取口令哈希即可通过彩虹表或 GPU 高速暴力破解还原明文。注意：此处属于弱哈希（CWE-328），而非弱加密算法（CWE-327）。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "010.php"
                },
                "region": {
                  "startLine": 15,
                  "endLine": 16
                }
              }
            }
          ],
          "partialFingerprints": {
            "sunsetFindingId": "SEM-949d40928ae7"
          },
          "properties": {
