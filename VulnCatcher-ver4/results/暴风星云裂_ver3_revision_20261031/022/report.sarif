          },
          "properties": {
            "finding_id": "GEN-1ab8921b1132",
            "confidence": 0.4,
            "verdict": "candidate",
            "evidence_level": "rule_verified+llm",
            "cwe": "CWE-22",
            "endpoint": "/022",
            "http_method": "ANY",
            "has_poc": true,
            "origin": "rule"
          }
        },
        {
          "ruleId": "sunset/weak_crypto",
          "level": "warning",
          "message": {
            "text": "022.php 使用 MD5 处理口令（CWE-328 弱哈希）\n\n022.php:39 执行 $pass_new = md5( $pass_new );，将用户新口令以无盐 MD5 单轮哈希后写入数据库（022.php:43-44 的 UPDATE）。MD5 属于已破解的快速哈希算法，且此处未见盐值或迭代（如 password_hash/PBKDF2/bcrypt/argon2），口令存储强度不足。注意：该弱点类型应为 weak_hash（CWE-328），而非 weak_crypto（CWE-327，后者指 DES/ECB 等加密算法缺陷）。"
          },
          "locations": [
