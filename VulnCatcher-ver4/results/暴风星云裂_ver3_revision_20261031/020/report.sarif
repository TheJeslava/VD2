            "has_poc": true,
            "origin": "rule"
          }
        },
        {
          "ruleId": "sunset/client_side_validation",
          "level": "error",
          "message": {
            "text": "020.php 依赖外部脚本且服务端未对 include 参数做校验（CWE-602）\n\n020.php:14-15 将外部输入拼入 `<script src>`，页面行为依赖客户端加载的外部脚本；服务端在 020.php:13 仅用 `isset()` 判断参数存在，未做任何服务端校验。若业务逻辑依赖该脚本执行校验或渲染，攻击者可通过替换脚本源或直接构造请求绕过客户端校验。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "020.php"
                },
                "region": {
                  "startLine": 14,
                  "endLine": 15
                }
              }
            }
          ],
          "partialFingerprints": {
            "sunsetFindingId": "SEM-cc52c467496c"
          },
          "properties": {
            "finding_id": "SEM-cc52c467496c",
            "confidence": 0.4,
            "verdict": "candidate",
            "evidence_level": "rule_verified+llm",
            "cwe": "CWE-602",
            "endpoint": "/020",
            "http_method": "ANY",
            "has_poc": true,
            "origin": "rule"
          }
        },
        {
          "ruleId": "sunset/xss",
          "level": "warning",
          "message": {
            "text": "020.php 中 POST 参数 include 未编码直接拼入 <script src> 导致反射型 XSS\n\n脚本在第 13 行读取 $_POST['include']，在第 14-16 行将其原样拼接进 <script src='...'></script> 并输出到响应体，未做 HTML 实体编码、URL 校验或白名单过滤。攻击者可通过构造 include 值闭合单引号并注入任意 HTML/JS，实现反射型 XSS。虽然第 3-5 行设置了 CSP（script-src 白名单），但 CSP 仅限制脚本来源，不阻止注入内联 HTML 结构（如 <img onerror>、<svg onload> 等事件处理器在部分浏览器/配置下仍可执行），且白名单中包含 pastebin.com、unpkg.com、cdn.jsdelivr.net 等可托管任意 JS 的公共 CDN，攻击者可借助这些域加载恶意脚本，CSP 无法有效防护。"
          },
          "locations": [
