      "results": [
        {
          "ruleId": "sunset/sql_injection",
          "level": "error",
          "message": {
            "text": "DVWA SQL 注入模块：$_SESSION['id'] 直接拼接进 SQL 查询（MySQL/SQLite 双分支）\n\n040.php 从 $_SESSION['id'] 读取 $id，未做任何类型转换、转义或参数化，直接以单引号包裹拼入 SELECT 语句。MySQL 分支（第 10 行）与 SQLite 分支（第 28 行）均存在同一缺陷。攻击者只要能控制会话中的 id 值（DVWA 的 SQL 注入页面会把用户提交的 id 写入 $_SESSION['id']，或通过会话固定/会话注入手段写入），即可闭合单引号注入任意 SQL 语法，读取 users 表以外的数据（如 dvwa.users 的 password 字段、information_schema），造成数据库信息泄露与认证凭据窃取。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "040.php"
                },
                "region": {
                  "startLine": 5,
                  "endLine": 11
                }
              }
            }
          ],
          "partialFingerprints": {
            "sunsetFindingId": "LLM-b04dcf20e12f"
          },
          "properties": {
            "finding_id": "LLM-b04dcf20e12f",
            "confidence": 0.8,
            "verdict": "candidate",
            "evidence_level": "llm_inferred",
            "cwe": "CWE-89",
            "endpoint": "/vulnerabilities/sqli/",
            "http_method": "GET",
            "has_poc": true,
            "origin": "llm_finding"
          }
        },
        {
          "ruleId": "sunset/xss",
          "level": "warning",
          "message": {
            "text": "040.php 将未转义的 $id 直接输出到 HTML（反射/存储型 XSS）\n\n第 20 行与第 44 行把 $id 直接插入 HTML 字符串 $html 输出，未做 htmlspecialchars 转义。若 $id 来自会话中的用户输入，则可注入脚本，在受害者浏览器执行，窃取会话或执行敏感操作。"
          },
          "locations": [
