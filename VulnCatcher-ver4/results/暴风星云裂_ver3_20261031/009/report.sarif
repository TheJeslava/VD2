            "confidence": 0.68,
            "verdict": "candidate",
            "evidence_level": "rule_verified+llm",
            "cwe": "CWE-89",
            "endpoint": "/009",
            "http_method": "ANY",
            "has_poc": true,
            "origin": "rule"
          }
        },
        {
          "ruleId": "sunset/sql_injection",
          "level": "error",
          "message": {
            "text": "009.php 用户详情查询 user_id 参数 SQL 注入（CWE-89）\n\n同一外部输入 `user_id`（009.php:17）在通过存在性检查后，被再次拼接进 `$query = \"SELECT first_name, last_name, user_id, avatar FROM users WHERE user_id = '$id';\"`（009.php:28），并在 009.php:29 由 `mysqli_query($GLOBALS[\"___mysqli_ston\"], $query)` 执行。`$id` 未做转义或参数化，攻击者可用单引号闭合注入 UNION SELECT 等语句，从 users 表或其他表读取任意列数据。"
          },
          "locations": [
