            "cwe": "CWE-22",
            "endpoint": "/020",
            "http_method": "ANY",
            "has_poc": true,
            "origin": "rule"
          }
        },
        {
          "ruleId": "sunset/xss",
          "level": "warning",
          "message": {
            "text": "020.php 通过 POST 参数 include 反射注入 script src，CSP 白名单可被绕过导致任意脚本执行\n\n020.php 第 13-17 行在收到 POST 参数 include 时，未做任何 HTML 属性编码或 URL 白名单校验，直接把 $_POST['include'] 拼进 <script src='...'> 的单引号属性中。攻击者可闭合单引号并注入任意属性/标签，或直接指向 CSP 白名单内可托管任意 JS 的域（pastebin.com、hastebin.com、unpkg.com、cdn.jsdelivr.net、digi.ninja 等），从而在受害者浏览器执行任意脚本。第 3-5 行设置的 CSP 明确把上述域列入 script-src，等于为攻击者提供了合法的脚本托管源，CSP 无法阻止利用。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "020.php"
                },
                "region": {
                  "startLine": 13,
                  "endLine": 17
