            "http_method": "ANY",
            "has_poc": true,
            "origin": "rule"
          }
        },
        {
          "ruleId": "sunset/sql_injection",
          "level": "error",
          "message": {
            "text": "058_06.php 登录认证 SELECT 语句 SQL 注入（CWE-89）\n\n攻击者通过 query 参数 `login_user`（058_06.php:20 读取，`$username`、`$password` 均来自请求）提交输入，被拼入 058_06.php:22 的 `$sql = \"SELECT * FROM users WHERE username='$username' and password='$password'\"`，并在 058_06.php:24 由 `mysql_query($sql)` 执行。用户名与口令均以单引号字符串拼接，未做转义或绑定，攻击者可用 `' OR '1'='1' -- -` 使条件恒真，绕过认证。"
          },
