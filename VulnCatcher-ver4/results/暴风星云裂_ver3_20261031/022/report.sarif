            "evidence_level": "rule_verified+llm",
            "cwe": "CWE-89",
            "endpoint": "/022",
            "http_method": "ANY",
            "has_poc": true,
            "origin": "rule"
          }
        },
        {
          "ruleId": "sunset/path_traversal",
          "level": "error",
          "message": {
            "text": "022.php JSON 请求体读取被误判为路径穿越（CWE-22）\n\n候选将 022.php:8 的 `json_decode(file_get_contents('php://input'), true)` 标记为路径穿越汇点。实际分析：`file_get_contents` 的参数是固定字符串 `php://input`，并非由外部输入拼接而成；外部 JSON 数据仅作为 `json_decode` 的输入进入 `$data`，未参与任何文件路径构造。因此不存在攻击者可控路径到达文件读写操作，该候选不成立。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "022.php"
                },
                "region": {
