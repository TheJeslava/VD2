            "evidence_level": "rule_verified+llm",
            "cwe": "CWE-89",
            "endpoint": "/015",
            "http_method": "ANY",
            "has_poc": true,
            "origin": "rule"
          }
        },
        {
          "ruleId": "sunset/captcha_bypass",
          "level": "error",
          "message": {
            "text": "DVWA 密码修改流程 CAPTCHA 状态机可绕过（直接提交 step=2 与 passed_captcha=true）\n\n015.php 的密码修改被拆成两步：step=1 时调用 recaptcha_check_answer 校验验证码，通过后渲染一个隐藏表单，其中包含 step=2、passed_captcha=true 以及用户输入的 password_new/password_conf；step=2 分支只检查 $_POST['passed_captcha'] 是否为真值，完全不重新校验 CAPTCHA，也不校验该值是否由服务端签发。攻击者可以跳过 step=1，直接 POST step=2、passed_captcha=true、password_new、password_conf，从而在未通过任何 CAPTCHA 的情况下修改当前登录用户的密码。该逻辑使 CAPTCHA 保护形同虚设，可被用于自动化口令变更/账户接管链（配合 CSRF 或撞库后的会话）。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "015.php"
                },
                "region": {
                  "startLine": 46,
                  "endLine": 69
                }
              }
            }
          ],
          "partialFingerprints": {
