          },
          "properties": {
            "finding_id": "GEN-2b40f95f1bb0",
            "confidence": 0.83,
            "verdict": "candidate",
            "evidence_level": "rule_verified+llm",
            "cwe": "CWE-78",
            "endpoint": "/027",
            "http_method": "ANY",
            "has_poc": true,
            "origin": "rule"
          }
        },
        {
          "ruleId": "sunset/command_injection",
          "level": "error",
          "message": {
            "text": "027.php *nix 分支 ping -c 4 命令拼接导致 OS 命令注入（CWE-78）\n\n攻击者通过 HTTP query 参数 `ip` 提供输入，027.php:5 将其读入 `$target`；当 027.php:17 的平台判断不成立（非 Windows，即 *nix 分支）时，027.php:23 执行 `$cmd = shell_exec( 'ping  -c 4 ' . $target );`，把 `$target` 直接拼接到 shell 命令。代码未对 `$target` 做白名单校验或 `escapeshellarg` 转义，`ip` 中的 `;`、`|`、`&&`、`$()`、反引号等元字符会被 shell 解释，构成命令注入。该分支在 Linux/Unix 主机上默认触发，是主要利用路径。"
          },
          "locations": [
