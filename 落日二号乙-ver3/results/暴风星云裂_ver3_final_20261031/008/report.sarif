        {
          "ruleId": "sunset/sql_injection",
          "level": "error",
          "message": {
            "text": "008.php 用户存在性检查 SQL 注入（CWE-89）\n\nquery 参数 `user_id`（008.php:19）进入 `$id` 后，在 008.php:22 被直接拼接为 `SELECT user_id FROM users WHERE user_id = $id`，未做类型转换或转义，随后在 008.php:23 由 `mysqli_query` 执行。攻击者可在 `user_id` 中注入布尔/UNION 载荷，改变查询语义。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "008.php"
                },
