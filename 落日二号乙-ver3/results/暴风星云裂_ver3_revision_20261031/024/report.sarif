            "sunsetFindingId": "GEN-cf38b1a2cb95"
          },
          "properties": {
            "finding_id": "GEN-cf38b1a2cb95",
            "confidence": 0.45,
            "verdict": "candidate",
            "evidence_level": "rule_verified+llm",
            "cwe": "CWE-89",
            "endpoint": "/024",
            "http_method": "ANY",
            "has_poc": true,
            "origin": "rule"
          }
        },
        {
          "ruleId": "sunset/csrf",
          "level": "error",
          "message": {
            "text": "DVWA 密码修改功能仅依赖 HTTP_REFERER 校验，可被 CSRF 绕过实现账户接管\n\n024.php 第 3 行通过 `$_GET['Change']` 触发密码修改流程，第 5 行仅用 `stripos($_SERVER['HTTP_REFERER'], $_SERVER['SERVER_NAME']) !== false` 判断请求来源，随后第 7-8 行直接读取 `password_new`/`password_conf`，第 11 行比较相等后在第 14 行 md5 并在第 18-19 行执行 UPDATE 修改当前用户密码。HTTP_REFERER 完全由客户端控制，攻击者可在恶意页面中构造 Referer 包含目标域名的请求，或直接省略/伪造该头，从而绕过唯一的“来源校验”。整个流程没有任何 CSRF token、没有对原密码的验证、没有二次确认，属于典型的认证后 CSRF 导致账户接管。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "024.php"
                },
                "region": {
                  "startLine": 3,
                  "endLine": 19
                }
              }
            }
          ],
          "partialFingerprints": {
