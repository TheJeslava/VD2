            "confidence": 0.4,
            "verdict": "candidate",
            "evidence_level": "rule_verified+llm",
            "cwe": "CWE-89",
            "endpoint": "/023",
            "http_method": "ANY",
            "has_poc": true,
            "origin": "rule"
          }
