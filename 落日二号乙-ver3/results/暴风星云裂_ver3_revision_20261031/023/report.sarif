        {
          "ruleId": "sunset/csrf",
          "level": "error",
          "message": {
            "text": "DVWA 密码修改接口（023.php）缺少 CSRF token 与旧密码校验，可被跨站强制改密接管账户\n\n023.php 在 `isset($_GET['Change'])` 成立时直接读取 `$_GET['password_new']` 与 `$_GET['password_conf']`，仅比较两者是否相等（第 9 行），随后 md5 后拼入 UPDATE 语句修改当前登录用户的密码（第 16-17 行）。整个流程没有任何 CSRF token、没有 Referer/Origin 校验、也没有要求提供旧密码。攻击者只需诱导已登录受害者在浏览器中访问一个携带 `Change=Change&password_new=X&password_conf=X` 的链接（GET 请求，可放入 <img> 标签），即可把受害者密码改为攻击者已知值，随后用新密码登录接管账户。由于是 GET 方法且无 token，利用门槛极低。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "023.php"
                },
                "region": {
                  "startLine": 3,
                  "endLine": 17
                }
              }
            }
          ],
