        {
          "ruleId": "sunset/command_injection",
          "level": "error",
          "message": {
            "text": "027.php ping 功能通过 $_REQUEST['ip'] 拼接 shell_exec 导致命令注入\n\n脚本在收到 POST 参数 Submit 后，从 $_REQUEST['ip'] 读取用户输入 $target，仅用 str_replace 删除 '&&' 与 ';' 两个黑名单字符串，随后直接拼接进 shell_exec('ping -c 4 ' . $target)（Windows 分支为 'ping ' . $target）。黑名单不覆盖管道符 |、命令替换 $()、反引号、换行符 %0a、后台符 &、以及 || 等，攻击者可在 ip 参数中注入任意系统命令，以 Web 服务进程权限执行，导致远程代码执行。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "027.php"
                },
                "region": {
                  "startLine": 3,
                  "endLine": 24
                }
              }
            }
          ],
