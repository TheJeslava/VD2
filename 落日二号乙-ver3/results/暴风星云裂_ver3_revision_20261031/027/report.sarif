            "has_poc": true,
            "origin": "llm_finding"
          }
        },
        {
          "ruleId": "sunset/command_injection",
          "level": "error",
          "message": {
            "text": "027.php Windows 分支 ping 命令拼接导致 OS 命令注入（CWE-78）\n\n攻击者通过 HTTP 查询参数 `ip` 提供输入（027.php:5 读取该参数并赋给 `$target`）。当 `php_uname('s')` 返回包含 `Windows NT` 的字符串时，代码进入 Windows 分支（027.php:17-18），在 027.php:19 执行 `$cmd = shell_exec( 'ping  ' . $target );`，把未净化的 `$target` 直接拼接到 shell 命令字符串中。代码未对 `$target` 做任何白名单校验、转义（如 escapeshellarg/escapeshellcmd）或参数化处理，因此 `$target` 中的 shell 元字符（如 `&`、`|`、`;`、`&&`）会被 shell 解释，从而执行攻击者附加的命令。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "027.php"
                },
                "region": {
                  "startLine": 17,
                  "endLine": 19
                }
              }
            }
          ],
