            "confidence": 0.4,
            "verdict": "candidate",
            "evidence_level": "rule_verified+llm",
            "cwe": "CWE-307",
            "endpoint": "/012",
            "http_method": "ANY",
            "has_poc": true,
            "origin": "rule"
          }
        },
        {
          "ruleId": "sunset/weak_crypto",
          "level": "warning",
          "message": {
            "text": "012.php 使用 MD5 存储口令（CWE-328 弱哈希）\n\n012.php:10 先对 `$pass` 做 mysqli_real_escape_string，随后 012.php:11 执行 `$pass = md5( $pass );`，将用户口令以无盐 MD5 形式参与后续 SQL 比较（012.php:14 的 password 字段）。MD5 为快速、无盐、已被证明存在碰撞的哈希算法，用于口令存储/校验属安全用途误用。注意：此处应归类为 weak_hash（CWE-328），而非 weak_crypto（CWE-327，指 DES/ECB 等加密算法问题）。"
          },
          "locations": [
