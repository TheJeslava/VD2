      "results": [
        {
          "ruleId": "sunset/sql_injection",
          "level": "error",
          "message": {
            "text": "012.php 登录表单 SQL 注入（CWE-89）\n\n攻击者通过 HTTP GET 参数 `username`（以及同表单的 `password`）提交输入。012.php:5 从请求中读取 `username` 到 `$user`，012.php:10 仅对 `$pass` 调用 mysqli_real_escape_string，而 `$user` 未见任何转义或参数化处理；012.php:14 将 `$user` 与 `$pass` 直接拼接进 SQL 语句 \"SELECT * FROM `users` WHERE user = '$user' AND password = '$pass';\"，012.php:15 通过 mysqli_query 执行该语句。由于 `$user` 未经转义即进入单引号字符串上下文，攻击者可闭合引号注入任意 SQL 片段（如 `' OR '1'='1' -- `），校验完全失效。此外 012.php:15 的 die() 分支会把 mysqli_error 的数据库错误信息回显到页面，构成报错型注入的辅助信息泄露通道。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "012.php"
                },
                "region": {
                  "startLine": 13,
                  "endLine": 15
                }
              }
            }
          ],
          "partialFingerprints": {
            "sunsetFindingId": "GEN-3b547dba7a60"
          },
          "properties": {
            "finding_id": "GEN-3b547dba7a60",
            "confidence": 0.83,
            "verdict": "candidate",
            "evidence_level": "rule_verified+llm",
            "cwe": "CWE-89",
            "endpoint": "/012",
            "http_method": "ANY",
            "has_poc": true,
            "origin": "rule"
          }
        },
        {
          "ruleId": "sunset/brute_force",
          "level": "error",
          "message": {
            "text": "012.php 登录接口缺少暴力破解防护（CWE-307）\n\n012.php:3 通过 `isset( $_GET[ 'Login' ] )` 判定登录请求，随后在 012.php:5 读取 `username`、012.php:10-11 处理 `password` 并查询数据库。整个流程中未见失败计数、账号锁定、验证码、延迟或速率限制逻辑，攻击者可对同一账号无限次提交口令猜测。需说明：该结论基于本文件可见代码，若存在上游 WAF/网关限流则实际风险降低，属证据不足部分。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "012.php"
                },
                "region": {
                  "startLine": 2,
                  "endLine": 3
                }
              }
            }
          ],
          "partialFingerprints": {
