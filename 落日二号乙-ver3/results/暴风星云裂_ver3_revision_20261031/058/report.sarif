          }
        },
        {
          "ruleId": "sunset/weak_id",
          "level": "error",
          "message": {
            "text": "058_08.php 登出使用固定值 Cookie 且缺少安全属性（CWE-330/CWE-614）\n\n058_08.php:65-66 在 `session_destroy()` 后执行 `setcookie('Auth', 1, time()-3600)`，以常量 1 作为 Cookie 值并仅通过过期时间清除；该 Cookie 未设置 HttpOnly/Secure/SameSite 属性。常量值本身不携带随机性，且清除依赖客户端时间。"
          },
