        {
          "ruleId": "sunset/auth_bypass",
          "level": "error",
          "message": {
            "text": "058_06.php 登录后仅设置 Auth=1 Cookie，058_08.php 等页面仅凭该 Cookie 判定已登录，可伪造 Cookie 绕过认证\n\n058_06.php 登录成功后执行 setcookie(\"Auth\", 1, time()+3600)，仅写入固定值 1，不含签名/会话绑定。058_08.php 第7-14行、058_01.php 第3-10行、058_04.php 第3-10行仅检查 isset($_COOKIE[\"Auth\"]) 即认为已认证（058_08.php 中即使 $_SESSION 不存在，只要 Cookie 存在就不跳转）。攻击者手工设置 Cookie Auth=1 即可绕过登录访问受保护页面（改密、登录后页面），无需有效凭据。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "058_08.php"
                },
                "region": {
                  "startLine": 7,
                  "endLine": 14
                }
              }
            }
          ],
          "partialFingerprints": {
