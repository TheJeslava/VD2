            "confidence": 0.83,
            "verdict": "candidate",
            "evidence_level": "llm_inferred",
            "cwe": "CWE-287",
            "endpoint": "/058_08.php",
            "http_method": "GET",
            "has_poc": true,
            "origin": "llm_finding"
          }
        },
        {
          "ruleId": "sunset/weak_id",
          "level": "error",
          "message": {
            "text": "058_06.php 认证 Cookie 使用固定值（CWE-330/CWE-565）\n\n058_06.php:44 `setcookie(\"Auth\", 1, time()+3600)` 将认证标志 Cookie 设为常量 1，而非不可预测的随机会话标识；058_06.php:43 仅把用户名写入 `$_SESSION[\"username\"]`。任何客户端只要自行设置 `Auth=1` 即可伪造该标志，服务端无法区分合法与伪造。"
          },
          "locations": [
