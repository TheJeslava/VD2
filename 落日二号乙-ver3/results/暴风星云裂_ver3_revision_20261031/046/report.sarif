      "results": [
        {
          "ruleId": "sunset/weak_id",
          "level": "error",
          "message": {
            "text": "会话标识由可预测递增计数器派生（CWE-330）\n\n046.php 第 5 行在 POST 请求下进入分支，第 6 行检查 if (!isset($_SESSION['last_session_id_high']))，第 7 行将其初始化为 0，随后第 9 行自增、第 10 行 md5 后写入 Cookie。会话标识的唯一熵来源是会话内单调递增的整数计数器，既不含随机数也不含时间戳混合，攻击者可通过观察自己的一次令牌推断计数器区间，进而预测同站点其他会话的令牌序列。校验无效的原因：代码没有任何随机化或服务端绑定校验，仅依赖“值递增”这一可预测模式。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "046.php"
                },
                "region": {
                  "startLine": 5,
                  "endLine": 6
                }
              }
            }
          ],
          "partialFingerprints": {
            "sunsetFindingId": "SEM-19354a0facf2"
          },
          "properties": {
            "finding_id": "SEM-19354a0facf2",
            "confidence": 0.75,
            "verdict": "candidate",
            "evidence_level": "rule_verified+llm",
            "cwe": "CWE-330",
