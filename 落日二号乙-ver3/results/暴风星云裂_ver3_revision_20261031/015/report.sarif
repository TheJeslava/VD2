        {
          "ruleId": "sunset/weak_hash",
          "level": "warning",
          "message": {
            "text": "改密流程使用无盐 MD5 存储口令（015.php:65）\n\n第 65 行对用户新口令仅做 md5() 后写入 users.password，未使用盐值或慢哈希（bcrypt/argon2）。MD5 计算极快且可彩虹表/GPU 爆破，一旦数据库泄露口令可被快速还原；同时无盐导致相同口令哈希相同，可做批量比对。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "015.php"
                },
                "region": {
