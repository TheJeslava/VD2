                "text": "OS 命令注入（CWE-78）"
              },
              "fullDescription": {
                "text": "外部输入进入 shell/进程执行参数，攻击者可追加或替换系统命令。"
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/78.html",
              "properties": {
                "tags": [
                  "command_injection",
                  "CWE-78",
                  "security"
                ]
              }
            }
          ]
        }
      },
      "invocations": [
