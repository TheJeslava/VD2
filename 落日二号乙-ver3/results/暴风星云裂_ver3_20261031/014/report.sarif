          },
          "properties": {
            "finding_id": "LLM-ecdc7684a376",
            "confidence": 0.87,
            "verdict": "candidate",
            "evidence_level": "llm_inferred",
            "cwe": "CWE-804",
            "endpoint": "/014.php",
            "http_method": "POST",
            "has_poc": true,
            "origin": "llm_finding"
          }
        },
        {
          "ruleId": "sunset/captcha_bypass",
          "level": "error",
          "message": {
            "text": "014.php 验证码流程可绕过（CWE-804）\n\n014.php:3 通过 `isset($_POST['Change']) && $_POST['step'] == '1'` 判断是否进入修改口令分支，step 由客户端 POST 控制。攻击者可直接提交 step=1 与 Change 参数跳过验证码展示/校验阶段，直接进入口令修改逻辑（014.php:7-9 读取 password_new/password_conf，014.php:60-61 执行 UPDATE）。输入点为 POST 参数 step 与 Change，缺少服务端会话绑定的验证码状态校验，因此校验无效。"
          },
          "locations": [
