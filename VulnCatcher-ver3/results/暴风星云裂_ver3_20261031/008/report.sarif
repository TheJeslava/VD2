            "confidence": 0.68,
            "verdict": "candidate",
            "evidence_level": "rule_verified+llm",
            "cwe": "CWE-89",
            "endpoint": "/008",
            "http_method": "ANY",
            "has_poc": true,
            "origin": "rule"
          }
        },
        {
          "ruleId": "sunset/sql_injection",
          "level": "error",
          "message": {
            "text": "008.php 日志写入处 SQL 注入（CWE-89）\n\n008.php:79-80 构造 `$log_query = \"INSERT INTO bac_log (user_id, target_id, ip_address) VALUES ({$current_user_id}, {$target_id}, '{$ip}')\"`，并在 008.php:81 由 `mysqli_query($GLOBALS[\"___mysqli_ston\"], $log_query)` 执行。其中 `$target_id` 与 `$current_user_id` 来源于同一外部 query 参数 `user_id`（008.php:19）派生，`$ip` 为客户端可影响的地址值，均以字符串拼接方式进入 INSERT 语句，未参数化、未转义。攻击者可在 `user_id` 中注入闭合 VALUES 的片段，改写 INSERT 语义。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "008.php"
                },
                "region": {
                  "startLine": 79,
                  "endLine": 81
                }
              }
            }
          ],
          "partialFingerprints": {
