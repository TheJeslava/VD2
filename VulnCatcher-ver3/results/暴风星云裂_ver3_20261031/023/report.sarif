          }
        },
        {
          "ruleId": "sunset/csrf",
          "level": "error",
          "message": {
            "text": "DVWA 密码修改接口（023.php）缺少 CSRF token，可被跨站强制修改当前用户密码\n\n023.php 在 `isset($_GET['Change'])` 成立时直接读取 `password_new`/`password_conf` 并执行 `UPDATE users SET password=...`，整个流程没有任何 CSRF token、Referer 校验或原密码确认。攻击者只需诱导已登录受害者访问一个自动提交的页面（GET 请求即可，甚至可用 <img> 标签），即可把受害者密码改为攻击者已知的值，随后用新密码登录接管账户。由于该接口使用 GET 且无 token，属于典型的认证后 CSRF（CWE-352）。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "023.php"
                },
                "region": {
                  "startLine": 3,
                  "endLine": 17
                }
              }
            }
          ],
          "partialFingerprints": {
