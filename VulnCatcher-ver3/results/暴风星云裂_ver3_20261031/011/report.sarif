      "results": [
        {
          "ruleId": "sunset/sql_injection",
          "level": "error",
          "message": {
            "text": "011.php 登录处 username 参数直接拼接进 SQL 导致认证绕过式 SQL 注入\n\n011.php 第 3 行判断 $_GET['Login'] 存在后，第 5 行直接读取 $_GET['username'] 到 $user，未做任何转义/参数化；第 12 行将 $user 以单引号包裹拼进 SELECT 语句，第 13 行交给 mysqli_query 执行。攻击者可通过 username 注入恒真条件（如 ' OR '1'='1' -- -）绕过密码校验，返回 users 表首行，从而以任意/首个用户身份登录受保护区域；也可用 UNION/布尔/报错注入读取任意数据库内容。password 虽经 md5() 处理（第 9 行），但 md5 输出为固定 32 位十六进制，无法注入，因此注入点唯一在 username。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "011.php"
                },
                "region": {
                  "startLine": 5,
                  "endLine": 13
                }
              }
            }
          ],
          "partialFingerprints": {
            "sunsetFindingId": "LLM-c969ca7950b6"
          },
          "properties": {
            "finding_id": "LLM-c969ca7950b6",
            "confidence": 0.9,
            "verdict": "candidate",
            "evidence_level": "llm_inferred",
            "cwe": "CWE-89",
            "endpoint": "/011.php",
            "http_method": "GET",
            "has_poc": true,
            "origin": "llm_finding"
          }
        },
        {
          "ruleId": "sunset/brute_force",
          "level": "error",
          "message": {
            "text": "011.php 登录接口缺少暴力破解防护（CWE-307）\n\n011.php:3 以 if(isset($_GET['Login'])) 进入登录流程，读取 username/password 并查询数据库，但整个文件中未见失败计数、账号锁定、验证码、延迟或速率限制逻辑。攻击者可对同一接口无限次提交口令猜测。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "011.php"
                },
                "region": {
                  "startLine": 2,
                  "endLine": 3
                }
              }
            }
          ],
          "partialFingerprints": {
            "sunsetFindingId": "SEM-bb3630458a80"
          },
          "properties": {
            "finding_id": "SEM-bb3630458a80",
            "confidence": 0.6,
            "verdict": "candidate",
            "evidence_level": "rule_verified+llm",
            "cwe": "CWE-307",
            "endpoint": "/011",
            "http_method": "ANY",
            "has_poc": true,
            "origin": "rule"
          }
        },
        {
          "ruleId": "sunset/weak_crypto",
          "level": "warning",
          "message": {
            "text": "011.php 使用 MD5 处理口令（CWE-328 弱哈希）\n\n011.php:8 从 $_GET['password'] 取得明文口令，011.php:9 直接 $pass = md5($pass) 后用于 011.php:12 的登录比对。MD5 为快速、无盐、已被证明存在碰撞的哈希算法，用于口令存储/校验属弱哈希。注意：该弱点本质是 weak_hash（CWE-328），而非 weak_crypto（CWE-327，指 DES/ECB 等加密算法误用）。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "011.php"
                },
                "region": {
                  "startLine": 8,
                  "endLine": 9
                }
              }
            }
          ],
          "partialFingerprints": {
