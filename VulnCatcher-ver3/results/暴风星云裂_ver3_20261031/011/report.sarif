          },
          "properties": {
            "finding_id": "SEM-2ea8df0ef3b9",
            "confidence": 0.76,
            "verdict": "candidate",
            "evidence_level": "rule_verified+llm",
            "cwe": "CWE-327",
            "endpoint": "/011",
            "http_method": "ANY",
            "has_poc": true,
            "origin": "rule"
          }
        },
        {
          "ruleId": "sunset/xss",
          "level": "warning",
          "message": {
            "text": "011.php 登录成功页将 username 原样回显导致反射型 XSS\n\n第 21 行将 $user（来自 $_GET['username']，第 5 行）直接拼入 HTML 输出 \"<p>Welcome to the password protected area {$user}</p>\"，未做 htmlspecialchars 等编码。虽然该分支需登录成功才触发，但结合同文件 SQL 注入（username 恒真注入）可让攻击者构造同时满足注入与脚本注入的 payload，使页面回显攻击者脚本，构成反射型 XSS。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "011.php"
                },
                "region": {
                  "startLine": 5,
                  "endLine": 21
