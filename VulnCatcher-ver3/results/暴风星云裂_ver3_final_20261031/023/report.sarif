            "http_method": "GET",
            "has_poc": true,
            "origin": "llm_finding"
          }
        },
        {
          "ruleId": "sunset/brute_force",
          "level": "error",
          "message": {
            "text": "023.php 口令修改流程缺少速率限制与失败锁定（CWE-307）\n\n023.php:5-6 直接读取 password_new/password_conf 并进入修改流程，代码中未见失败计数、账户锁定、验证码或速率限制逻辑。但该文件本身是口令修改功能，并非登录认证入口，是否构成可被枚举的认证面取决于未给出的登录模块与会话校验，故按现有证据只能判定为防护缺失而非可直接利用的暴力破解。"
          },
