            "confidence": 0.45,
            "verdict": "candidate",
            "evidence_level": "rule_verified+llm",
            "cwe": "CWE-307",
            "endpoint": "/011",
            "http_method": "ANY",
            "has_poc": true,
            "origin": "rule"
          }
        },
        {
          "ruleId": "sunset/weak_crypto",
          "level": "warning",
          "message": {
            "text": "011.php 使用 MD5 处理口令（CWE-328 弱哈希）\n\n011.php:8 从 `$_GET['password']` 取口令，011.php:9 直接调用 `md5($pass)` 生成摘要后用于与数据库中的口令值比较。MD5 为快速、无盐的通用哈希，抗碰撞与抗暴力能力均已失效，且此处未见盐值或迭代（如 bcrypt/Argon2/PBKDF2）。注意：该问题本质是弱哈希（CWE-328），而非弱加密算法（CWE-327）。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "011.php"
                },
                "region": {
                  "startLine": 8,
                  "endLine": 9
