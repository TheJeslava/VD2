            "confidence": 0.9,
            "verdict": "candidate",
            "evidence_level": "llm_inferred",
            "cwe": "CWE-89",
            "endpoint": "/011.php",
            "http_method": "GET",
            "has_poc": true,
            "origin": "llm_finding"
          }
        },
        {
          "ruleId": "sunset/brute_force",
          "level": "error",
          "message": {
            "text": "011.php 登录接口缺少暴力破解防护（CWE-307）\n\n011.php:3 通过 `isset($_GET['Login'])` 判定登录请求，随后在 011.php:5/8 读取 `username`/`password` 并直接查询校验。代码中未见失败计数、账户锁定、验证码、速率限制或延迟等任何反暴力机制，攻击者可对同一账号无限次提交口令猜测。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "011.php"
                },
                "region": {
                  "startLine": 2,
                  "endLine": 3
                }
              }
            }
          ],
          "partialFingerprints": {
