            "confidence": 0.7,
            "verdict": "candidate",
            "evidence_level": "rule_verified+llm",
            "cwe": "CWE-330",
            "endpoint": "/046",
            "http_method": "ANY",
            "has_poc": true,
            "origin": "rule"
          }
        },
        {
          "ruleId": "sunset/weak_random",
          "level": "warning",
          "message": {
            "text": "DVWA weak_id 会话标识可预测：dvwaSession 由自增计数器 md5 生成\n\n046.php 在每次 POST 请求时把 $_SESSION['last_session_id_high'] 自增（第 9 行），然后直接对其做 md5 作为 Cookie 值 dvwaSession（第 10-11 行）。该值完全由单调递增的整数决定，不含任何随机源（无 random_bytes / random_int / uniqid / mt_rand），因此攻击者只要获得任意一个 dvwaSession 值，即可通过 md5(1..N) 穷举出全部历史与未来会话标识，从而伪造/预测其他用户的会话标识，属于可预测会话标识（CWE-330 / CWE-340，弱随机）。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "046.php"
                },
                "region": {
                  "startLine": 9,
                  "endLine": 11
                }
              }
            }
          ],
          "partialFingerprints": {
            "sunsetFindingId": "LLM-e9310d5416a7"
          },
          "properties": {
            "finding_id": "LLM-e9310d5416a7",
            "confidence": 0.85,
            "verdict": "candidate",
            "evidence_level": "llm_inferred",
            "cwe": "CWE-330",
            "endpoint": "/vulnerabilities/weak_id/",
            "http_method": "POST",
            "has_poc": true,
            "origin": "llm_finding"
          }
        },
        {
          "ruleId": "sunset/weak_crypto",
          "level": "warning",
          "message": {
            "text": "046 弱哈希用于会话标识（CWE-328）\n\n046.php 第 10 行 $cookie_value = md5($_SESSION['last_session_id_high']); 使用 MD5 对自增会话计数器做哈希，并在第 11 行作为 dvwaSession Cookie 值下发。MD5 属于已被攻破的弱哈希算法（存在碰撞与快速暴力枚举），且此处输入空间仅为连续小整数，攻击者可瞬间穷举全部候选值。校验无效的原因：MD5 不提供任何抗预测性，哈希输出与输入一一对应且可离线计算，无法作为安全凭据的保护手段。最终危险操作是第 11 行 setcookie 将 MD5 派生值作为会话标识下发并被服务端接受。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "046.php"
                },
                "region": {
                  "startLine": 9,
                  "endLine": 10
                }
              }
            }
          ],
