        {
          "ruleId": "sunset/insecure_cookie",
          "level": "note",
          "message": {
            "text": "dvwaSession Cookie 未设置 HttpOnly 与 Secure 标志\n\n第 11 行 setcookie 的第 6、7 个参数分别为 false、false，即 httponly=false、secure=false，导致会话标识 Cookie 可被 JavaScript 读取且可在明文 HTTP 下传输，一旦存在 XSS 即可直接窃取该 Cookie。"
          },
