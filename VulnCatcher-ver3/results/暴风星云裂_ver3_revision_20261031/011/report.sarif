      "results": [
        {
          "ruleId": "sunset/sql_injection",
          "level": "error",
          "message": {
            "text": "011.php 登录接口 username 参数 SQL 注入（可绕过认证）\n\n011.php 第 3 行以 $_GET['Login'] 存在为条件进入登录逻辑，第 5 行直接取 $_GET['username'] 赋给 $user，未做任何转义/参数化；第 12 行将 $user 直接拼接进 SELECT 语句，第 13 行通过 mysqli_query 执行。攻击者可在 username 中注入 SQL 语法（如 ' OR '1'='1' -- -）改变查询语义，绕过密码校验以任意用户（含管理员）身份登录，或通过 UNION/布尔盲注读取 users 表全部数据。password 虽经 md5() 处理，但 md5 输出为固定 32 位十六进制，无法注入，故注入点唯一为 username。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "011.php"
                },
                "region": {
                  "startLine": 5,
                  "endLine": 13
                }
              }
            }
          ],
          "partialFingerprints": {
            "sunsetFindingId": "LLM-c969ca7950b6"
          },
          "properties": {
            "finding_id": "LLM-c969ca7950b6",
            "confidence": 0.9,
            "verdict": "candidate",
            "evidence_level": "llm_inferred",
            "cwe": "CWE-89",
            "endpoint": "/011.php",
            "http_method": "GET",
            "has_poc": true,
            "origin": "llm_finding"
          }
        },
        {
          "ruleId": "sunset/brute_force",
          "level": "error",
          "message": {
            "text": "011.php 登录接口缺少暴力破解防护（CWE-307）\n\n011.php:3 通过 `isset($_GET['Login'])` 进入登录流程，读取 `username`/`password` 后直接查询数据库并返回结果。代码中未见失败计数、账户锁定、验证码、延迟或速率限制逻辑，攻击者可对同一账户无限次提交口令猜测。证据为 011.php:2-3 的登录入口判断及后续无任何限流代码；该结论为基于源码的推断，未做运行时验证。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "011.php"
                },
                "region": {
                  "startLine": 2,
                  "endLine": 3
                }
              }
            }
          ],
          "partialFingerprints": {
            "sunsetFindingId": "SEM-bb3630458a80"
          },
          "properties": {
            "finding_id": "SEM-bb3630458a80",
            "confidence": 0.45,
            "verdict": "candidate",
            "evidence_level": "rule_verified+llm",
            "cwe": "CWE-307",
            "endpoint": "/011",
            "http_method": "ANY",
            "has_poc": true,
            "origin": "rule"
          }
        },
        {
          "ruleId": "sunset/weak_crypto",
          "level": "warning",
          "message": {
            "text": "011.php 使用 MD5 存储/比对口令（CWE-328）\n\n011.php:8 从 GET 参数 `password` 读取明文口令，011.php:9 调用 `md5($pass)` 生成摘要，随后在 011.php:12 的 SQL 中与数据库 `password` 字段比对。MD5 为快速、无盐、可碰撞的哈希算法，用于口令等安全用途时无法抵抗离线暴力破解与彩虹表攻击。此处为配置/实现型弱点，不依赖 HTTP 污点链，证据为 011.php:9 的 `md5(` 调用原文。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "011.php"
                },
                "region": {
                  "startLine": 8,
                  "endLine": 9
